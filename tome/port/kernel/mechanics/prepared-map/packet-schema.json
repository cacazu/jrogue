{
  "name": "Original native map preparation observer",
  "version": 1,
  "byte_order": "little_endian",
  "production_replay_ready": false,
  "packet_header_bytes": 64,
  "packet_header": [
    [0,"magic","ascii4 TMP1"], [4,"version","u32"], [8,"header_bytes","u32"],
    [12,"gaps_and_observations","u32"], [16,"application_epoch","u64 <=2^53-1"],
    [24,"packet_bytes","u32"], [28,"event_count","u32"], [32,"batch_count","u32"],
    [36,"native_map_width","u32"], [40,"native_map_height","u32"], [44,"native_zdepth","u32"],
    [48,"original_keyframes","i32"], [52,"native_map_entries","u32 expected1"],
    [56,"native_map_returns","u32 expected1"], [60,"reserved","u32 zero"]
  ],
  "event_prefix_bytes": 16,
  "event_prefix": [[0,"kind","u32"],[4,"record_bytes_including_prefix","u32"],[8,"source_sequence","u32"],[12,"current_native_layer","i32"]],
  "event_kinds": {
    "1":"actual GL_TRIANGLES batch", "2":"original object callback begins", "3":"original object callback returned",
    "4":"original z callback begins", "5":"original z callback returned", "6":"original native-tail FOV source slot begins",
    "7":"original native-tail FOV source slot completed", "8":"actual final CPU seen-texture bytes"
  },
  "batch": {
    "fixed_payload_bytes":216,
    "fields":[[0,"gl_mode","u32"],[4,"vertex_count N","u32 multiple6 <=30000"],[8,"actual active-unit 2D texture binding","u32"],[12,"cached native shader program","u32"],[16,"cached native framebuffer","u32"],[20,"actual active texture unit","u32"],[24,"quad_count Q","u32=N/6"],[28,"capture_flags_at_batch","u32"],[32,"actual viewport","i32[4]"],[48,"actual scissor box","i32[4]"],[64,"actual blend enabled","u32 bool"],[68,"actual scissor enabled","u32 bool"],[72,"actual blend factors RGBsource/RGBdestination/Alphasource/Alphadestination","u32[4]"],[88,"actual modelview matrix","f32[16]"],[152,"actual projection matrix","f32[16]"]],
    "variable_data":["f32[2*N] exact original vertices","f32[2*N] exact original texture coordinates","f32[4*N] exact original colors","i32[3*Q] per-quad actual selected layer,x,y"],
    "record_bytes":"16+216+32*N+12*Q"
  },
  "seen_bytes": {
    "fixed_payload_bytes":16,
    "fields":[[0,"native seen texture ID","u32"],[4,"texture_width W","u32"],[8,"texture_height H","u32"],[12,"original GL_BGRA format","u32"]],
    "variable_data":"u8[W*H*4] copied original seens_map bytes",
    "record_bytes":"16+16+W*H*4",
    "timing":"After original native map FOV and seen texture update; before later Lua map particle cleanup"
  },
  "bits": {
    "1":"missing immutable resource leases/versions", "2":"foreign callback GL output not captured",
    "4":"shader uniforms/samplers not captured", "8":"GL state capture is partial",
    "16":"native client-array metadata did not match original map buffers", "32":"original callback reported error",
    "64":"packet budget/allocation overflow", "128":"native map lifecycle/count/reentrancy failure",
    "256":"nonfinite geometry/queried transform", "512":"original native-tail FOV source slot was observed"
  },
  "minimum_remaining_capture":"Texture creation/upload/deletion versions and ownership; shader code/uniform/sampler values including time; foreign object/z/particle callbacks; enclosing map FBO/compositor/seen-overlay/gridline commands; full original GL state; ordered original domain preparation and live particle state."
}
