    {
      "archive": "engine",
      "path": "engine/Game.lua",
      "member_sha256": "7c8c458c142289fe8b4e59e5c16376303f9a10d34e858fabc48d84c6aa04e523",
      "member_bytes": 26231,
      "line_count": 848,
      "excerpts": [
        {
          "start_line": 194,
          "end_line": 211,
          "lines": [
            "\tself:handleEvents()",
            "",
            "\t-- Check timers",
            "\tif self._timers_cb and nb_keyframes > 0 then",
            "\t\tlocal new = {}",
            "\t\tlocal exec = {}",
            "\t\tfor cb, frames in pairs(self._timers_cb) do",
            "\t\t\tframes = frames - nb_keyframes",
            "\t\t\tif frames <= 0 then exec[#exec+1] = cb",
            "\t\t\telse new[cb] = frames end",
            "\t\tend",
            "\t\tif next(new) then self._timers_cb = new",
            "\t\telse self._timers_cb = nil end",
            "\t\tfor _, cb in ipairs(exec) do cb() end",
            "\tend",
            "",
            "\t-- Update tweening engine",
            "\tif nb_keyframes > 0 then tween.update(nb_keyframes) end"
          ]
        },
        {
          "start_line": 231,
          "end_line": 243,
          "lines": [
            "function _M:handleEvents()",
            "\tlocal evt = profile:popEvent()",
            "\twhile evt do",
            "\t\tself:handleProfileEvent(evt)",
            "\t\tevt = profile:popEvent()",
            "\tend",
            "end",
            "",
            "--- Receives a profile event",
            "-- Usually this just transfers it to the PlayerProfile class but you can overload it to handle special stuff",
            "-- @param evt the event",
            "function _M:handleProfileEvent(evt)",
            "\treturn profile:handleEvent(evt)"
          ]
        }
      ]
    },
    {
      "archive": "engine",
      "path": "engine/interface/GameTargeting.lua",
      "member_sha256": "83269becc384af2cbe1484fbcd2c7d01dbb8cc67cc1405d18371ffb2f2fe6313",
      "member_bytes": 17848,
