        {
          "start_line": 67,
          "end_line": 88,
          "lines": [
            "function _M:targetDisplayTooltip(dx, dy, force, nb_keyframes)",
            "\t-- Tooltip is displayed over all else",
            "\tif self.level and self.level.map and self.level.map.finished then",
            "\t\tlocal tmx, tmy",
            "\t\t-- Display a tooltip if available",
            "\t\tif self.tooltip_x then",
            "\t\t\tif type(self.tooltip_x) == \"table\" then",
            "\t\t\t\tself.tooltip:toScreen(self.tooltip.last_display_x, self.tooltip.last_display_y, nb_keyframes)",
            "\t\t\telse",
            "\t\t\t\ttmx, tmy = self.level.map:getMouseTile(self.tooltip_x , self.tooltip_y)",
            "\t\t\t\tself.tooltip:displayAtMap(tmx, tmy, dx, dy, nil, force, nb_keyframes)",
            "\t\t\tend",
            "\t\tend",
            "",
            "\t\t-- Move target around",
            "\t\tif self.old_tmx ~= tmx or self.old_tmy ~= tmy then",
            "\t\t\tif not (self.target_mode and self.target_no_move_tooltip) then",
            "\t\t\t\tself.target.target.x, self.target.target.y = tmx, tmy",
            "\t\t\tend",
            "\t\tend",
            "\t\tself.old_tmx, self.old_tmy = tmx, tmy",
            "\tend"
          ]
        }
      ]
    },
