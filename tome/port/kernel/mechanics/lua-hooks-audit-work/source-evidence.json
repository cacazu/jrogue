    {
      "archive": "tome",
      "path": "mod/class/GameState.lua",
      "member_sha256": "98fa5672db560a0965a4d2e38de37cd9a2fe933271a93da46b73fc74190eaf7a",
      "member_bytes": 170718,
      "line_count": 3858,
      "excerpts": [
        {
          "start_line": 900,
          "end_line": 921,
          "lines": [
            "function _M:playAmbientSounds(level, s, nb_keyframes)",
            "\tfor i = 1, #s do",
            "\t\tlocal data = s[i]",
            "",
            "\t\tif data._sound then if not data._sound:playing() then data._sound = nil end end",
            "",
            "\t\tif not data._sound and nb_keyframes > 0 and rng.chance(math.ceil(data.chance / nb_keyframes)) then",
            "\t\t\tlocal f = rng.table(data.files)",
            "\t\t\tdata._sound = game:playSound(f)",
            "\t\t\tlocal pos = {x=0,y=0,z=0}",
            "\t\t\tif data.random_pos then",
            "\t\t\t\tlocal a, r = rng.float(0, 2 * math.pi), rng.float(1, data.random_pos.rad or 10)",
            "\t\t\t\tpos.x = math.cos(a) * r",
            "\t\t\t\tpos.y = math.sin(a) * r",
            "\t\t\tend",
            "--\t\t\tprint(\"===playing\", data.name, f, data._sound)",
            "\t\t\tif data._sound then",
            "\t\t\t\tif data.volume_mod then data._sound:volume(data._sound:volume() * data.volume_mod) end",
            "\t\t\t\tif data.pitch then data._sound:pitch(data.pitch) end",
            "\t\t\tend",
            "\t\tend",
            "\tend"
          ]
        },
        {
          "start_line": 941,
          "end_line": 946,
          "lines": [
            "function _M:displayWeather(level, ps, nb_keyframes)",
            "\tlocal dx, dy = level.map:getScreenUpperCorner() -- Display at map border, always, so it scrolls with the map",
            "\tfor j = 1, #ps do",
            "\t\tps[j].ps:toScreen(dx, dy, true, 1)",
            "\tend",
            "end"
          ]
        }
      ]
    },
    {
      "archive": "tome",
      "path": "mod/class/Tooltip.lua",
      "member_sha256": "69a2d8b3f0b6567d5dc093121c196c41b1831021669ad96a26945bafd06ac15b",
      "member_bytes": 2324,
      "line_count": 78,
      "excerpts": [
        {
          "start_line": 29,
          "end_line": 60,
          "lines": [
            "function _M:getTooltipAtMap(tmx, tmy, mx, my)",
            "\tif self.locked then return nil end",
            "\tlocal tt = {}",
            "\tlocal seen = game.level.map.seens(tmx, tmy)",
            "\tlocal remember = game.level.map.remembers(tmx, tmy)",
            "\t",
            "\tlocal check = function(check_type)",
            "\t\tlocal to_add = game.level.map:checkEntity(tmx, tmy, check_type, \"tooltip\", game.level.map.actor_player)",
            "\t\tif to_add then ",
            "\t\t\tif type(to_add) == \"string\" then to_add = to_add:toTString() end",
            "\t\t\tif to_add.is_tstring then ",
            "\t\t\t\ttt[#tt+1] = to_add ",
            "\t\t\telse ",
            "\t\t\t\ttable.append(tt, to_add) ",
            "\t\t\tend",
            "\t\tend",
            "\t\treturn to_add",
            "\tend",
            "\t",
            "\tif seen or remember and not core.key.modState(\"ctrl\") then",
            "\t\tcheck(Map.TRAP)",
            "\t\tif seen then check(Map.ACTOR) end",
            "\t\tcheck(Map.OBJECT)",
            "",
            "\t\tif seen then",
            "\t\t\t-- search for all projectiles (kludge! consider implementing like Objects)",
            "\t\t\t\tlocal to_add",
            "\t\t\t\tfor uid, e in pairs(game.level.entities) do",
            "\t\t\t\t\tif e.__is_projectile and e.x == tmx and e.y == tmy then",
            "\t\t\t\t\t\tto_add = e:check(\"tooltip\", tmx, tmy)",
            "\t\t\t\t\t\tif to_add then ",
            "\t\t\t\t\t\t\tif type(to_add) == \"string\" then to_add = to_add:toTString() end"
          ]
        }
      ]
    },
