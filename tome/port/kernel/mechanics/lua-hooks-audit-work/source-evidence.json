          "lines": [
            "\t\tlocal meteor = function(src, x, y, dam, radius)",
            "\t\t\tgame.level.map:particleEmitter(x, y, 10, \"meteor\", {x=x, y=y, dam=dam, radius=radius}).on_remove = function(self)",
            "\t\t\t\tlocal x, y = self.args.x, self.args.y",
            "\t\t\t\tlocal dam = self.args.dam",
            "\t\t\t\tlocal radius = self.args.radius",
            "\t\t\t\tgame.level.map:particleEmitter(x, y, 10, \"fireflash\", {radius=radius})",
            "\t\t\t\tgame:playSoundNear(game.player, \"talents/fireflash\")",
            "",
            "\t\t\t\tlocal grids = {}",
            "\t\t\t\tfor i = x-radius, x+radius do for j = y-radius, y+radius do",
            "\t\t\t\t\tlocal oe = game.level.map(i, j, engine.Map.TERRAIN)",
            "\t\t\t\t\tif oe and not oe:attr(\"temporary\") and",
            "\t\t\t\t\t(core.fov.distance(x, y, i, j) < 1 or rng.percent(40)) and (game.level.map:checkEntity(i, j, engine.Map.TERRAIN, \"dig\") or game.level.map:checkEntity(i, j, engine.Map.TERRAIN, \"grow\")) then",
            "\t\t\t\t\t\tlocal g = terrains.LAVA_FLOOR:clone()",
            "\t\t\t\t\t\tg:resolve() g:resolve(nil, true)",
            "\t\t\t\t\t\tgame.zone:addEntity(game.level, g, \"terrain\", i, j)",
            "\t\t\t\t\t\tgrids[#grids+1] = {x=i,y=j,oe=oe}",
            "\t\t\t\t\tend",
            "\t\t\t\tend end",
            "\t\t\t\tfor i = x-radius, x+radius do for j = y-radius, y+radius do",
            "\t\t\t\t\tgame.nicer_tiles:updateAround(game.level, i, j)",
            "\t\t\t\tend end",
            "\t\t\t\tfor _, spot in ipairs(grids) do",
            "\t\t\t\t\tlocal i, j = spot.x, spot.y",
            "\t\t\t\t\tlocal g = game.level.map(i, j, engine.Map.TERRAIN)",
            "\t\t\t\t\tg.temporary = 8",
            "\t\t\t\t\tg.x = i g.y = j",
            "\t\t\t\t\tg.canAct = false",
            "\t\t\t\t\tg.energy = { value = 0, mod = 1 }",
            "\t\t\t\t\tg.old_feat = spot.oe",
            "\t\t\t\t\tg.useEnergy = mod.class.Trap.useEnergy",
            "\t\t\t\t\tg.act = function(self)",
            "\t\t\t\t\t\tself:useEnergy()",
            "\t\t\t\t\t\tself.temporary = self.temporary - 1",
            "\t\t\t\t\t\tif self.temporary <= 0 then",
            "\t\t\t\t\t\t\tgame.level.map(self.x, self.y, engine.Map.TERRAIN, self.old_feat)",
            "\t\t\t\t\t\t\tgame.level:removeEntity(self)",
            "\t\t\t\t\t\t\tgame.nicer_tiles:updateAround(game.level, self.x, self.y)",
            "\t\t\t\t\t\tend",
            "\t\t\t\t\tend",
            "\t\t\t\t\tgame.level:addEntity(g)",
            "\t\t\t\tend",
            "",
            "\t\t\t\tsrc:project({type=\"ball\", radius=radius}, x, y, engine.DamageType.METEOR, dam)",
            "\t\t\t\tsrc:project({type=\"ball\", radius=radius}, x, y, function(px, py)",
            "\t\t\t\t\tlocal target = game.level.map(px, py, engine.Map.ACTOR)",
            "\t\t\t\t\tif target then",
            "\t\t\t\t\t\tif target:canBe(\"stun\") then",
            "\t\t\t\t\t\t\ttarget:setEffect(target.EFF_STUNNED, 3, {apply_power=getParadoxSpellpower(src, t)})",
            "\t\t\t\t\t\telse",
            "\t\t\t\t\t\t\tgame.logSeen(target, \"%s resists the stun!\", target:getName():capitalize())",
            "\t\t\t\t\t\tend",
            "\t\t\t\t\tend",
            "\t\t\t\tend)",
            "\t\t\t\tif core.shader.allow(\"distort\") then game.level.map:particleEmitter(x, y, radius, \"shockwave\", {radius=radius}) end",
            "\t\t\t\tgame:getPlayer(true):attr(\"meteoric_crash\", 1)"
          ]
        }
      ]
