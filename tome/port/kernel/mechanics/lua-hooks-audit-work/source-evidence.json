            "function _M:display(x, y, nb_keyframe, always_show, prevfbo)",
            "\tnb_keyframes = nb_keyframes or 1",
            "\tlocal ox, oy = rawget(self, \"display_x\"), rawget(self, \"display_y\")",
            "\tself.display_x, self.display_y = x or self.display_x, y or self.display_y",
            "",
            "\tself._map:toScreen(self.display_x, self.display_y, nb_keyframe, always_show, self.changed, prevfbo)",
            "",
            "\tself.display_x, self.display_y = ox, oy",
            "",
            "\tself:removeParticleEmitters()",
            "",
            "\t-- If nothing changed, return the same surface as before",
            "\tif not self.changed then return end",
            "\tself.changed = false",
            "\tself.clean_fov = true",
            "end",
            "",
            "--- Called by the engine map draw code for each z-layer",
            "function _M:zDisplay(z, nb_keyframe, prevfbo)",
            "\tself:calcEffectVisibility(z)",
            "\tself:displayParticles(z, nb_keyframe)",
            "\tself:displayEffects(z, prevfbo, nb_keyframe)",
            "\treturn true"
          ]
        },
        {
          "start_line": 1435,
          "end_line": 1448,
          "lines": [
            "function _M:removeParticleEmitters()",
            "\tif #self.particles_todel == 0 then return end",
            "\ttable.sort(self.particles_todel)",
            "",
            "\tfor i = #self.particles_todel, 1, -1 do",
            "\t\tlocal e = table.remove(self.particles, self.particles_todel[i])",
            "\t\tif e then",
            "\t\t\tself.z_particles[e.zdepth][e] = nil",
            "",
            "\t\t\tif e.on_remove then e:on_remove() end",
            "\t\t\te.dead = true",
            "\t\tend",
            "\tend",
            "\tself.particles_todel = {}"
          ]
        },
        {
          "start_line": 1482,
          "end_line": 1501,
          "lines": [
            "\t\t\tif nb_keyframes == 0 and e.x and e.y then",
            "\t\t\t\t-- Just display it, not updating, no emitting",
            "\t\t\t\tif e.x + e.radius >= self.mx and e.x - e.radius < self.mx + self.viewport.mwidth and e.y + e.radius >= self.my and e.y - e.radius < self.my + self.viewport.mheight then",
            "\t\t\t\t\te.ps:toScreen(dx + (adx + e.x - self.mx + 0.5) * self.tile_w * self.zoom, dy + (ady + e.y - self.my + 0.5 + util.hexOffset(e.x)) * self.tile_h * self.zoom, show_particle, e.zoom * self.zoom)",
            "\t\t\t\tend",
            "\t\t\telseif e.x and e.y then",
            "\t\t\t\talive = e.ps:isAlive()",
            "",
            "\t\t\t\t-- Update more, if needed",
            "\t\t\t\tif alive and e.x + e.radius >= self.mx and e.x - e.radius < self.mx + self.viewport.mwidth and e.y + e.radius >= self.my and e.y - e.radius < self.my + self.viewport.mheight then",
            "\t\t\t\t\te.ps:toScreen(dx + (adx + e.x - self.mx + 0.5) * self.tile_w * self.zoom, dy + (ady + e.y - self.my + 0.5 + util.hexOffset(e.x)) * self.tile_h * self.zoom, show_particle)",
            "\t\t\t\tend",
            "",
            "\t\t\t\tif not alive then",
            "\t\t\t\t\tself:removeParticleEmitter(e)",
            "\t\t\t\tend",
            "\t\t\telse",
            "\t\t\t\tself:removeParticleEmitter(e)",
            "\t\t\tend",
            "\t\tend"
          ]
        },
        {
          "start_line": 1542,
          "end_line": 1563,
          "lines": [
            "function _M:displayEmotes(nb_keyframes)",
            "\tlocal del = {}",
            "\tlocal e = next(self.emotes)",
            "\tlocal sx, sy = self._map:getScroll()",
            "\twhile e do",
            "\t\t-- Dont bother with obviously out of screen stuff",
            "\t\tif e.x >= self.mx and e.x < self.mx + self.viewport.mwidth and e.y >= self.my and e.y < self.my + self.viewport.mheight and self.seens(e.x, e.y) then",
            "\t\t\te:display(self.display_x + sx + (e.x - self.mx + 0.5) * self.tile_w * self.zoom, self.display_y + sy + (e.y - self.my - 0.9) * self.tile_h * self.zoom)",
            "\t\tend",
            "",
            "\t\tfor i = 1, nb_keyframes do",
            "\t\t\tif e:update() then",
            "\t\t\t\tdel[#del+1] = e",
            "\t\t\t\te.dead = true",
            "\t\t\t\tbreak",
            "\t\t\tend",
            "\t\tend",
            "",
            "\t\te = next(self.emotes, e)",
            "\tend",
            "\tfor i = 1, #del do self.emotes[del[i]] = nil end",
            "end"
          ]
        }
      ]
