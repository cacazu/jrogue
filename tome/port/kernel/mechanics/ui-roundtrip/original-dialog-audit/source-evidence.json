    {
      "path": "engine/Mouse.lua",
      "member_sha256": "e0735962e4ddc0d15bfb732a4640bbee813933adb9a44222bd0930f1fc1f5ccd",
      "member_bytes": 8815,
      "line_count": 270,
      "excerpts": [
        {
          "start_line": 57,
          "end_line": 75,
          "lines": [
            "function _M:receiveMouse(button, x, y, isup, force_name, extra)",
            "\tself.last_pos = { x = x, y = y }",
            "\tself.status[button] = not isup",
            "\tif not self:isEnabled() then return end",
            "\tif not self.allow_down and not isup then return end",
            "",
            "\tif _M.drag then",
            "\t\tif _M.drag.prestart then _M.drag = nil",
            "\t\telse return self:endDrag(x, y) end",
            "\tend",
            "",
            "\tfor i  = 1, #self.areas do",
            "\t\tlocal m = self.areas[i]",
            "\t\tif (not m.mode or m.mode.button) and (x >= m.x1 and x < m.x2 and y >= m.y1 and y < m.y2) and (not force_name or force_name == m.name) then",
            "\t\t\tlocal r = m.fct(button, x, y, nil, nil, (x-m.x1) / m.scale, (y-m.y1) / m.scale, isup and \"button\" or \"button-down\", extra)",
            "\t\t\tif r ~= false then break end",
            "\t\tend",
            "\tend",
            "end"
          ]
        },
        {
          "start_line": 104,
          "end_line": 122,
          "lines": [
            "--- Delegate an event from an other mouse handler",
            "-- if self.delegate_offset_x and self.delegate_offset_y are set hey will be used to change the actual coordinates",
            "function _M:delegate(button, mx, my, xrel, yrel, bx, by, event, name, extra)",
            "\tlocal ox, oy = (self.delegate_offset_x or 0), (self.delegate_offset_y or 0)",
            "\tmx = mx - ox",
            "\tmy = my - oy",
            "",
            "\tif event == \"button\" then self:receiveMouse(button, mx, my, true, name, extra)",
            "\telseif event == \"button-down\" then self:receiveMouse(button, mx, my, false, name, extra)",
            "\telseif event == \"motion\" then self:receiveMouseMotion(button, mx, my, xrel, yrel, name, extra)",
            "\tend",
            "end",
            "",
            "--- Setups as the current game keyhandler",
            "function _M:setCurrent()",
            "\tcore.mouse.set_current_handler(self)",
            "--\tif game then game.mouse = self end",
            "\t_M.current = self",
            "end"
          ]
        }
      ]
    },
