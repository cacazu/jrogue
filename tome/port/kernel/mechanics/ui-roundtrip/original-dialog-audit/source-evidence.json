            "function _M:init(t, no_gen)",
            "\tself.mouse = Mouse.new()",
            "\tself.key = KeyBind.new()",
            "",
            "\tif not rawget(self, \"ui\") then self.ui = self.ui end",
            "",
            "\tif t.font then",
            "\t\tif type(t.font) == \"table\" then",
            "\t\t\tself.font = core.display.newFont(t.font[1], t.font[2])",
            "\t\t\tself.font_h = self.font:lineSkip()",
            "\t\telse",
            "\t\t\tself.font = t.font",
            "\t\t\tself.font_h = self.font:lineSkip()",
            "\t\tend",
            "\tend",
            "\t",
            "\tif t.ui then self.ui = t.ui end",
            "",
            "\tif not self.ui_conf[self.ui] then self.ui = \"dark\" end",
            "",
            "\tif not no_gen then self:generate() end",
            "end"
          ]
        }
      ]
