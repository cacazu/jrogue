          "lines": [
            "function _M:registerDialog(d)",
            "\tif d.__refuse_dialog then return end",
            "\ttable.insert(self.dialogs, d)",
            "\tself.dialogs[d] = #self.dialogs",
            "\td.__stack_id = #self.dialogs",
            "\tif d.key then d.key:setCurrent() end",
            "\tif d.mouse then d.mouse:setCurrent() end",
            "\tif d.on_register then d:on_register() end",
            "\tif self.onRegisterDialog then self:onRegisterDialog(d) end",
            "end"
          ]
        },
        {
          "start_line": 470,
          "end_line": 484,
          "lines": [
            "function _M:unregisterDialog(d)",
            "\tif not self.dialogs[d] then return end",
            "\ttable.remove(self.dialogs, self.dialogs[d])",
            "\tself.dialogs[d] = nil",
            "\td:cleanup()",
            "\td:unload()",
            "\t-- Update positions",
            "\tfor i, id in ipairs(self.dialogs) do id.__stack_id = i self.dialogs[id] = i end",
            "",
            "\tlocal last = (#self.dialogs > 0) and self.dialogs[#self.dialogs] or self",
            "\tif last.key then last.key:setCurrent() end",
            "\tif last.mouse then last.mouse:setCurrent() end",
            "\tif self.onUnregisterDialog then self:onUnregisterDialog(d) end",
            "\tif last.on_recover_focus then last:on_recover_focus() end",
            "end"
          ]
        }
      ]
    },
    {
      "path": "engine/ui/Button.lua",
      "member_sha256": "2f4961125d2cc90b8cee1c2947dcebac44e1d58b5d13bb4925892c71c066aef9",
      "member_bytes": 3929,
      "line_count": 114,
      "excerpts": [
        {
          "start_line": 33,
          "end_line": 65,
          "lines": [
            "function _M:init(t)",
            "\tself.text = assert(t.text, \"no button text\")",
            "\tself.fct = assert(t.fct, \"no button fct\")",
            "\tself.on_select = t.on_select",
            "\tself.force_w = t.width",
            "\tif t.can_focus ~= nil then self.can_focus = t.can_focus end",
            "\tif t.can_focus_mouse ~= nil then self.can_focus_mouse = t.can_focus_mouse end",
            "\tself.alpha_unfocus = t.alpha_unfocus or 1",
            "",
            "\tBase.init(self, t)",
            "end",
            "",
            "function _M:generate()",
            "\tself.mouse:reset()",
            "\tself.key:reset()",
            "",
            "\t-- Draw UI",
            "\tself.font:setStyle(\"bold\")",
            "\tlocal w, h = self.font:size(self.text)",
            "\tself.iw, self.ih = w, h",
            "\tif self.force_w then w = self.force_w end",
            "\tself.w, self.h = w - frame_ox1 + frame_ox2, h - frame_oy1 + frame_oy2",
            "",
            "\tself.tex = self:drawFontLine(self.font, self.text, w)",
            "\tself.font:setStyle(\"normal\")",
            "",
            "\t-- Add UI controls",
            "\tself.mouse:registerZone(0, 0, self.w+6, self.h+6, function(button, x, y, xrel, yrel, bx, by, event)",
            "\t\tif self.hide then return end",
            "\t\tif self.on_select then self.on_select() end",
            "\t\tif button == \"left\" and event == \"button\" then self:sound(\"button\") self.fct() end",
            "\tend)",
            "\tself.key:addBind(\"ACCEPT\", function() self:sound(\"button\") self.fct() end)"
          ]
        }
      ]
    },
    {
