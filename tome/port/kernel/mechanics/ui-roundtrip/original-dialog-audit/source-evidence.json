    {
      "path": "engine/KeyBind.lua",
      "member_sha256": "6a3d97f0d9ccf67585621a582ff7d79ef28db20714587c8c8ec8eb28a93dbd30",
      "member_bytes": 8351,
      "line_count": 296,
      "excerpts": [
        {
          "start_line": 214,
          "end_line": 244,
          "lines": [
            "function _M:receiveKey(sym, ctrl, shift, alt, meta, unicode, isup, key, ismouse)",
            "\tif not self:isEnabled() then return end",
            "\tif unicode and not self.use_unicode then return end",
            "",
            "\tself:handleStatus(sym, ctrl, shift, alt, meta, unicode, isup)",
            "",
            "\tif self.ignore[sym] then return end",
            "",
            "\tif self.any_key then self.any_key(sym, ctrl, shift, alt, meta, unicode, isup, key) end",
            "",
            "\tlocal ks, kks, us",
            "\tif not ismouse then ks, kks, us = self:makeKeyString(sym, ctrl, shift, alt, meta, unicode, key)",
            "\telse ks = self:makeMouseString(sym, ctrl, shift, alt, meta) end",
            "--\tprint(self, \"[BIND]\", sym, ctrl, shift, alt, meta, unicode, \" :=: \", ks, kks, us, \" ?=? \", self.binds[ks], kks and self.binds[kks], us and self.binds[us])",
            "\tif self.binds[ks] then",
            "\t\tfor virt, _ in pairs(self.binds[ks]) do if self.virtuals[virt] then",
            "\t\t\tif isup and not _M.binds_def[virt].updown then return end",
            "\t\t\tself.virtuals[virt](sym, ctrl, shift, alt, meta, unicode, isup, key)",
            "\t\t\treturn true",
            "\t\tend end",
            "\telseif kks and self.binds[kks] then",
            "\t\tfor virt, _ in pairs(self.binds[kks]) do if self.virtuals[virt] then",
            "\t\t\tif isup and not _M.binds_def[virt].updown then return end",
            "\t\t\tself.virtuals[virt](sym, ctrl, shift, alt, meta, unicode, isup, key)",
            "\t\t\treturn true",
            "\t\tend end",
            "\telseif us and self.binds[us] then",
            "\t\tfor virt, _ in pairs(self.binds[us]) do if self.virtuals[virt] then",
            "--\t\t\tif isup and not _M.binds_def[virt].updown then return end",
            "\t\t\tself.virtuals[virt](sym, ctrl, shift, alt, meta, unicode, isup, key)",
            "\t\t\treturn true"
          ]
        },
        {
          "start_line": 263,
          "end_line": 273,
          "lines": [
            "function _M:triggerVirtual(virtual)",
            "\tif not self.virtuals[virtual] then return end",
            "\tself.virtuals[virtual]()",
            "end",
            "",
            "--- Adds a key/command combination",
            "-- @param virtual the key to handle",
            "-- @param fct the function to call when the key is pressed",
            "function _M:addBind(virtual, fct)",
            "\tself.virtuals[virtual] = fct",
            "end"
          ]
        }
      ]
