          "lines": [
            "function _M:init(title, w, h, x, y, alpha, font, showup, skin)",
            "\tif self.force_ui_inside then",
            "\t\tself._lastui = self.ui",
            "\t\tBase:changeDefault(self.force_ui_inside)",
            "\t\tif _M.force_ui_inside_once then",
            "\t\t\t_M.force_ui_inside_once = nil",
            "\t\t\t_M.force_ui_inside = nil",
            "\t\tend",
            "\tend",
            "",
            "\tself.title = title",
            "\tself.alpha = self.alpha or 255",
            "\tif showup ~= nil then",
            "\t\tself.__showup = showup",
            "\telse",
            "\t\tself.__showup = 2",
            "\tend"
          ]
        },
        {
          "start_line": 504,
          "end_line": 520,
          "lines": [
            "\tself.mouse:allowDownEvent(true)",
            "\tif self.absolute then",
            "\t\tself.mouse:registerZone(0, 0, gamew, gameh, function(button, x, y, xrel, yrel, bx, by, event) self:mouseEvent(button, x, y, xrel, yrel, bx - self.display_x, by - self.display_y, event) end)",
            "\telse",
            "\t\tself.mouse:registerZone(0, 0, gamew, gameh, function(button, x, y, xrel, yrel, bx, by, event) if button == \"left\" and event == \"button\" then  self.key:triggerVirtual(\"EXIT\") end end)",
            "\t\tself.mouse:registerZone(self.display_x + self.frame.ox1, self.display_y + self.frame.ox2, self.frame.w, self.frame.h, function(...) self:no_focus() end)",
            "\t\tself.mouse:registerZone(self.display_x, self.display_y, self.w, self.h, function(...) self:mouseEvent(...) end)",
            "\tend",
            "\tself.key.receiveKey = function(_, ...) self:keyEvent(...) end",
            "\tself.key:addCommands{",
            "\t\t_TAB = function() self:moveFocus(1) end,",
            "\t\t_UP = function() self:moveFocus(-1) end,",
            "\t\t_DOWN = function() self:moveFocus(1) end,",
            "\t\t_LEFT = function() self:moveFocus(-1) end,",
            "\t\t_RIGHT = function() self:moveFocus(1) end,",
            "\t}",
            "\tself.key:addBind(\"SCREENSHOT\", function() if type(game) == \"table\" and game.key then game.key:triggerVirtual(\"SCREENSHOT\") end end)"
          ]
        },
        {
          "start_line": 537,
          "end_line": 553,
          "lines": [
            "function _M:loadUI(t)",
            "\tif not t.no_reset then",
            "\t\tself.uis = {}",
            "\t\tself.ui_by_ui = {}",
            "\t\tself.focus_ui = nil",
            "\t\tself.focus_ui_id = 0",
            "\tend",
            "\tfor i, ui in ipairs(t) do",
            "\t\tself.uis[#self.uis+1] = ui",
            "\t\tself.ui_by_ui[ui.ui] = ui",
            "",
            "\t\tif not self.focus_ui and ui.ui.can_focus then",
            "\t\t\tself:setFocus(i)",
            "\t\telseif ui.ui.can_focus then",
            "\t\t\tui.ui:setFocus(false)",
            "\t\tend",
            "\tend"
          ]
        },
        {
          "start_line": 715,
          "end_line": 723,
          "lines": [
            "\t\tui.x = ux",
            "\t\tui.y = uy",
            "\t\tui.ui.mouse.delegate_offset_x = ux",
            "\t\tui.ui.mouse.delegate_offset_y = uy",
            "\t\tui.ui:positioned(ux, uy, self.display_x + ux, self.display_y + uy)",
            "\tend",
            "",
            "\tself.setuped = true",
            "end"
          ]
        },
        {
          "start_line": 736,
          "end_line": 756,
          "lines": [
            "function _M:setFocus(id, how)",
            "\tif type(id) == \"table\" then",
            "\t\tfor i = 1, #self.uis do",
            "\t\t\tif self.uis[i].ui == id then id = i break end",
            "\t\tend",
            "\t\tif type(id) == \"table\" then self:no_focus() return end",
            "\tend",
            "",
            "\tlocal ui = self.uis[id]",
            "\tif self.focus_ui == ui then return end",
            "\tif self.focus_ui and (self.focus_ui.ui.can_focus or (self.focus_ui.ui.can_focus_mouse and how==\"mouse\")) then self.focus_ui.ui:setFocus(false) end",
            "\tif not ui.ui.can_focus then self:no_focus() return end",
            "\tself.focus_ui = ui",
            "\tself.focus_ui_id = id",
            "\tui.ui:setFocus(true)",
            "\tself:on_focus(id, ui)",
            "end",
            "",
            "function _M:getFocus()",
            "\tif not self.focus_ui then return nil end",
            "\treturn self.focus_ui.ui, self.focus_ui"
          ]
        },
        {
          "start_line": 809,
          "end_line": 842,
          "lines": [
            "function _M:mouseEvent(button, x, y, xrel, yrel, bx, by, event)",
            "\t-- Look for focus",
            "\tfor i = 1, #self.uis do",
            "\t\tlocal ui = self.uis[i]",
            "\t\tif (ui.ui.can_focus or ui.ui.can_focus_mouse) and bx >= ui.x and bx <= ui.x + ui.ui.w and by >= ui.y and by <= ui.y + ui.ui.h then",
            "\t\t\tself:setFocus(i, \"mouse\")",
            "",
            "\t\t\t-- Pass the event",
            "\t\t\tui.ui.mouse:delegate(button, bx, by, xrel, yrel, bx, by, event)",
            "\t\t\treturn",
            "\t\tend",
            "\tend",
            "\tself:no_focus()",
            "end",
            "",
            "function _M:keyEvent(...)",
            "\tif not self.focus_ui or not self.focus_ui.ui.key:receiveKey(...) then",
            "\t\tKeyBind.receiveKey(self.key, ...)",
            "\tend",
            "end",
            "function _M:display() end",
            "",
            "--- This does nothing and can be changed by other classes",
            "function _M:unload()",
            "end",
            "",
            "--- This provides required cleanups, do not touch",
            "function _M:cleanup()",
            "\tfor p, _ in pairs(self.particles) do p:dieDisplay() end",
            "",
            "\tfor i = 1, #self.uis do",
            "\t\tif self.uis[i].ui and self.uis[i].ui.on_dialog_cleanup then self.uis[i].ui:on_dialog_cleanup() end",
            "\tend",
            "end"
          ]
        }
