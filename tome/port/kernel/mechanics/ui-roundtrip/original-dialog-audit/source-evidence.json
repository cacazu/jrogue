          "lines": [
            "function _M:yesnoPopup(title, text, fct, yes_text, no_text, no_leave, escape, preexit_fct)",
            "\tlocal w, h = self.font:size(text)",
            "\tlocal d = new(title, 1, 1)",
            "",
            "--\td.key:addBind(\"EXIT\", function() game:unregisterDialog(d) fct(false) end)",
            "\tlocal ok = require(\"engine.ui.Button\").new{text=yes_text or _t\"Yes\", fct=function() if preexit_fct then preexit_fct(true) end game:unregisterDialog(d) fct(true) end}",
            "\tlocal cancel = require(\"engine.ui.Button\").new{text=no_text or _t\"No\", fct=function() if preexit_fct then preexit_fct(false) end game:unregisterDialog(d) fct(false) end}",
            "\tif not no_leave then d.key:addBind(\"EXIT\", function() if preexit_fct then preexit_fct(escape) end game:unregisterDialog(d) fct(escape) end) end",
            "\td:loadUI{",
            "\t\t{left = 3, top = 3, ui=require(\"engine.ui.Textzone\").new{width=w+20, height=h+5, text=text}},",
            "\t\t{left = 3, bottom = 3, ui=ok},",
            "\t\t{right = 3, bottom = 3, ui=cancel},",
            "\t}",
            "\td:setFocus(ok)",
            "\td:setupUI(true, true)",
            "",
            "\tgame:registerDialog(d)",
            "\treturn d",
            "end"
          ]
        },
        {
          "start_line": 169,
          "end_line": 189,
          "lines": [
            "function _M:yesnoLongPopup(title, text, w, fct, yes_text, no_text, no_leave, escape, preexit_fct)",
            "\tlocal d",
            "\tlocal ok = require(\"engine.ui.Button\").new{text=yes_text or _t\"Yes\", fct=function() if preexit_fct then preexit_fct(true) end game:unregisterDialog(d) fct(true) end}",
            "\tlocal cancel = require(\"engine.ui.Button\").new{text=no_text or _t\"No\", fct=function() if preexit_fct then preexit_fct(false) end game:unregisterDialog(d) fct(false) end}",
            "",
            "\tw = math.max(w + 20, ok.w + cancel.w + 10)",
            "",
            "\td = new(title, w + 6, 1)",
            "",
            "--\td.key:addBind(\"EXIT\", function() game:unregisterDialog(d) fct(false) end)",
            "\tif not no_leave then d.key:addBind(\"EXIT\", function() if preexit_fct then preexit_fct(escape) end game:unregisterDialog(d) fct(escape) end) end",
            "\td:loadUI{",
            "\t\t{left = 3, top = 3, ui=require(\"engine.ui.Textzone\").new{width=w, auto_height = true, text=text}},",
            "\t\t{left = 3, bottom = 3, ui=ok},",
            "\t\t{right = 3, bottom = 3, ui=cancel},",
            "\t}",
            "\td:setFocus(ok)",
            "\td:setupUI(false, true)",
            "",
            "\tgame:registerDialog(d)",
            "\treturn d"
          ]
        },
        {
