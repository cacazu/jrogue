            "local skip_key = {init=true, _NAME=true, _M=true, _PACKAGE=true, new=true, _BASES=true, castAs=true}",
            "--- Inherit",
            "-- @return function(c)",
            "function inherit(...)",
            "\tlocal bases = {...}",
            "\tlocal basenames = {}",
            "\tfor _, b in ipairs(bases) do if b._NAME then basenames[b._NAME] = true end end",
            "\treturn function(c)",
            "\t\tc._BASES = bases",
            "\t\t-- Recursive inheritance caching",
            "\t\t-- Inheritance proceeds from the first to last argument, so if the first and last base classes share a key the value will match the last base class",
            "\t\tif #bases > 1 then"
          ]
        },
        {
          "start_line": 114,
          "end_line": 147,
          "lines": [
            "\t\t\t\t\t-- Cache all the immediate variables",
            "--\t\t\t\t\tlocal ncopied = 0",
            "\t\t\t\t\tfor k, e in pairs(base) do",
            "\t\t\t\t\t\tif not skip_key[k] and (base[k] ~= nil) then",
            "--\t\t\t\t\t\t\tif c[k] ~= nil then",
            "--\t\t\t\t\t\t\t\tprint((\"INHERIT: *WARNING* replacing interface value %s (%s) from %s with (%s) from %s\"):format(k, tostring(c[k]), inheritance_mapper[k], tostring(base[k]), base._NAME))",
            "--\t\t\t\t\t\t\telse",
            "--\t\t\t\t\t\t\t\tprint((\"INHERIT: caching interface value %s (%s) from %s to %s\"):format(k, tostring(e), base._NAME, c._NAME))",
            "--\t\t\t\t\t\t\tend",
            "\t\t\t\t\t\t\tc[k] = base[k]",
            "--\t\t\t\t\t\t\tinheritance_mapper[k] = base._NAME",
            "--\t\t\t\t\t\t\tncopied = ncopied + 1",
            "\t\t\t\t\t\tend",
            "\t\t\t\t\tend",
            "--\t\t\t\t\tprint((\"INHERIT: cached %d values from %s to %s\"):format(ncopied, base._NAME, c._NAME))",
            "\t\t\t\t\tcompleted_bases[base] = true",
            "\t\t\t\t\tcompleted_bases[#completed_bases+1] = base",
            "\t\t\t\tend",
            "\t\t\tend",
            "\t\t\tlocal i = 1",
            "\t\t\twhile i <= #bases do",
            "--\t\t\t\tprint((\"INHERIT: base class #%d, %s\"):format(i, bases[i]._NAME))",
            "\t\t\t\tcache_inheritance(c, bases[i])",
            "\t\t\t\ti = i + 1",
            "\t\t\tend",
            "--\t\t\tprint((\"INHERIT: recursed through %d base classes for %s\"):format(#completed_bases, c._NAME))",
            "\t\tend",
            "\t\tsetmetatable(c, {__index=bases[1]})",
            "\t\tc.new = function(...)",
            "\t\t\tlocal obj = {}",
            "\t\t\tobj.__CLASSNAME = c._NAME",
            "\t\t\tobj.__ATOMIC = true",
            "\t\t\tsetmetatable(obj, {__index=c})",
            "\t\t\tif obj.init then obj:init(...) end"
