            "function _M:loadUI(t)",
            "\tif not t.no_reset then",
            "\t\tself.uis = {}",
            "\t\tself.ui_by_ui = {}",
            "\t\tself.focus_ui = nil",
            "\t\tself.focus_ui_id = 0",
            "\tend",
            "\tfor i, ui in ipairs(t) do",
            "\t\tself.uis[#self.uis+1] = ui",
            "\t\tself.ui_by_ui[ui.ui] = ui",
            "",
            "\t\tif not self.focus_ui and ui.ui.can_focus then",
            "\t\t\tself:setFocus(i)",
            "\t\telseif ui.ui.can_focus then",
            "\t\t\tui.ui:setFocus(false)",
            "\t\tend",
            "\tend"
          ]
        },
        {
          "start_line": 627,
          "end_line": 679,
          "lines": [
            "\tfor i, ui in ipairs(self.uis) do",
            "\t\tlocal ux, uy",
            "",
            "\t\tif not ui.absolute then",
            "\t\t\tux, uy = self.ix, self.iy",
            "",
            "\t\t\t-- At first, calculate ALL dependencies",
            "\t\t\tif ui.top and type(ui.top) == \"table\" then ui.top = self.ui_by_ui[ui.top].y - self.iy + ui.top.h + padding end",
            "\t\t\tif ui.bottom and type(ui.bottom) == \"table\" then",
            "\t\t\t\tlocal top = self.ui_by_ui[ui.bottom].y - self.iy  -- top of ui.bottom",
            "\t\t\t\tui.bottom = self.ih - top + padding",
            "\t\t\tend",
            "\t\t\tif ui.vcenter and type(ui.vcenter) == \"table\" then",
            "\t\t\t\tlocal vcenter = self.ui_by_ui[ui.vcenter].y + ui.vcenter.h",
            "\t\t\t\tui.vcenter = math.floor(vcenter - self.ih / 2)",
            "\t\t\tend",
            "",
            "\t\t\tif ui.left and type(ui.left) == \"table\" then ui.left = self.ui_by_ui[ui.left].x - self.ix + ui.left.w + padding end",
            "\t\t\tif ui.right and type(ui.right)== \"table\" then",
            "\t\t\t\tlocal left = self.ui_by_ui[ui.right].x - self.ix -- left of ui.right",
            "\t\t\t\tui.right = self.iw - left + padding",
            "\t\t\tend",
            "\t\t\tif ui.hcenter and type(ui.hcenter) == \"table\" then",
            "\t\t\t\tlocal hcenter = self.ui_by_ui[ui.hcenter].x - self.ix + ui.hcenter.w / 2",
            "\t\t\t\tui.hcenter = math.floor(hcenter - self.iw / 2)",
            "\t\t\tend",
            "\t\t\tif ui.hcenter_left and type(ui.hcenter_left) == \"table\" then  -- I still have no idea what that does",
            "\t\t\t\tui.hcenter_left = self.ui_by_ui[ui.hcenter_left].x + ui.hcenter_left.w",
            "\t\t\tend",
            "",
            "\t\t\tlocal regenerate = false",
            "\t\t\tif ui.calc_width then",
            "\t\t\t\tif ui.left and ui.right then",
            "\t\t\t\t\tui.ui.w = self.iw - (ui.right + ui.left)",
            "\t\t\t\telseif ui.left and ui.hcenter then",
            "\t\t\t\t\tui.ui.w = self.iw + 2 * (ui.hcenter - ui.left)",
            "\t\t\t\telseif ui.hcenter and ui.right then",
            "\t\t\t\t\tui.ui.w = self.iw + 2 * (-ui.hcenter - ui.right)",
            "\t\t\t\tend",
            "\t\t\t\tregenerate = true",
            "\t\t\tend",
            "\t\t\tif ui.calc_height then",
            "\t\t\t\tif ui.top and ui.bottom then",
            "\t\t\t\t\tui.ui.h = self.ih - (ui.bottom + ui.top)",
            "\t\t\t\telseif ui.top and ui.vcenter then",
            "\t\t\t\t\tui.ui.h = self.ih + 2 * (ui.vcenter - ui.top)",
            "\t\t\t\telseif ui.vcenter and ui.bottom then",
            "\t\t\t\t\tui.ui.h = self.ih + 2 * (-ui.vcenter - ui.bottom)",
            "\t\t\t\tend",
            "\t\t\t\tregenerate = true",
            "\t\t\tend",
            "\t\t\tif regenerate then",
            "\t\t\t\tui.ui:generate()"
          ]
        },
