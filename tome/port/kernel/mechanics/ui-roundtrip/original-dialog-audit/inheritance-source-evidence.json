            "--- Called when a dialog is registered to appear on screen",
            "function _M:onRegisterDialog(d)",
            "\t-- Clean up tooltip",
            "\tself.tooltip_x, self.tooltip_y = nil, nil",
            "\tself.tooltip2_x, self.tooltip2_y = nil, nil",
            "\tif self.player then self.player:updateMainShader() end",
            "",
            "\t-- Cleanup WASD",
            "\tself.wasd_state = {cnt=0, cd=12, base_cd=3}",
            "",
            "--\tif self.player and self.player.runStop then self.player:runStop(_t\"dialog poping up\") end",
            "--\tif self.player and self.player.restStop then self.player:restStop(_t\"dialog poping up\") end",
            "end",
            "function _M:onUnregisterDialog(d)",
            "\t-- Clean up tooltip",
            "\tself.tooltip_x, self.tooltip_y = nil, nil",
            "\tself.tooltip2_x, self.tooltip2_y = nil, nil",
            "\tif self.player then self.player:updateMainShader() self.player.changed = true end",
            "end"
          ]
        }
