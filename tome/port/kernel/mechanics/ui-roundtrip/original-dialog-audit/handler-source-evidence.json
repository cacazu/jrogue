          "lines": [
            "function _M:isEnabled()",
            "\tif not self.disable_until then return true end",
            "\tif core.game.getTime() < self.disable_until then ",
            "\t\tif game.log then game.log(\"#LIGHT_RED#Keyboard input temporarily disabled.\") end",
            "\t\treturn false",
            "\telse",
            "\t\tself.disable_until = nil",
            "\t\treturn true",
            "\tend",
            "end"
          ]
        },
        {
          "start_line": 89,
          "end_line": 94,
          "lines": [
            "--- Setup as the current game keyhandler",
            "function _M:setCurrent()",
            "\tcore.key.set_current_handler(self)",
            "--\tif game then game.key = self end",
            "\t_M.current = self",
            "end"
          ]
        }
      ]
