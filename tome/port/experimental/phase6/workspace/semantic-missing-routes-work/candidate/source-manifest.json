      "splice": {
        "line": 88,
        "before": "\tt.name = _t(t.name, \"talent name\")",
        "after": "\t-- Reviewed display leaves only; the original short_name is already final.\n\tif t.name == \"Activate Object\" and (t.short_name:match(\"^ACTIVATE_OBJECT_([1-9][0-9]?)$\") and tonumber(t.short_name:match(\"([0-9]+)$\")) <= 50) then\n\t\tt.name = _t(\"Activate Object\", \"talent name\")\n\telseif t.name == \"Infusion: Sun\" and t.short_name:match(\"^INFUSION:_SUN_[1-6]$\") then\n\t\tt.name = _t(\"Infusion: Sun\", \"talent name\")\n\telseif t.name == \"Taint: Telepathy\" and t.short_name:match(\"^TAINT:_TELEPATHY_[1-6]$\") then\n\t\tt.name = _t(\"Taint: Telepathy\", \"talent name\")\n\telseif t.name == \"Rune: Frozen Spear\" and t.short_name:match(\"^RUNE:_FROZEN_SPEAR_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Frozen Spear\", \"talent name\")\n\telseif t.name == \"Rune: Heat Beam\" and t.short_name:match(\"^RUNE:_HEAT_BEAM_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Heat Beam\", \"talent name\")\n\telseif t.name == \"Rune: Speed\" and t.short_name:match(\"^RUNE:_SPEED_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Speed\", \"talent name\")\n\telseif t.name == \"Rune: Vision\" and t.short_name:match(\"^RUNE:_VISION_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Vision\", \"talent name\")\n\telseif t.name == \"Rune: Phase Door\" and t.short_name:match(\"^RUNE:_PHASE_DOOR_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Phase Door\", \"talent name\")\n\telseif t.name == \"Rune: Controlled Phase Door\" and t.short_name:match(\"^RUNE:_CONTROLLED_PHASE_DOOR_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Controlled Phase Door\", \"talent name\")\n\telseif t.name == \"Rune: Lightning\" and t.short_name:match(\"^RUNE:_LIGHTNING_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Lightning\", \"talent name\")\n\telseif t.name == \"Infusion: Insidious Poison\" and t.short_name:match(\"^INFUSION:_INSIDIOUS_POISON_[1-6]$\") then\n\t\tt.name = _t(\"Infusion: Insidious Poison\", \"talent name\")\n\telseif t.name == \"Rune: Invisibility\" and t.short_name:match(\"^RUNE:_INVISIBILITY_[1-6]$\") then\n\t\tt.name = _t(\"Rune: Invisibility\", \"talent name\")\n\telseif t.name == \"Heave\" and t.short_name == \"HEAVE\" then\n\t\tt.name = _t(\"Heave\", \"talent name\")\n\telseif t.name == \"Slow Motion\" and t.short_name == \"SLOW_MOTION\" then\n\t\tt.name = _t(\"Slow Motion\", \"talent name\")\n\telseif t.name == \"Heat\" and t.short_name == \"HEAT\" then\n\t\tt.name = _t(\"Heat\", \"talent name\")\n\telseif t.name == \"Phase Shot\" and t.short_name == \"PHASE_SHOT\" then\n\t\tt.name = _t(\"Phase Shot\", \"talent name\")\n\telseif t.name == \"Unerring Shot\" and t.short_name == \"UNERRING_SHOT\" then\n\t\tt.name = _t(\"Unerring Shot\", \"talent name\")\n\telseif t.name == \"Perfect Aim\" and t.short_name == \"PERFECT_AIM\" then\n\t\tt.name = _t(\"Perfect Aim\", \"talent name\")\n\telseif t.name == \"Quick Shot\" and t.short_name == \"QUICK_SHOT\" then\n\t\tt.name = _t(\"Quick Shot\", \"talent name\")\n\telse\n\t\tt.name = _t(t.name, \"talent name\")\n\tend"
      },
