  "original_sources": {
    "main.c": {
      "sha256": "8359b9c86572d3b5ad5c5e6db632f3225e3a1154b2d1e30d3aae0503b581e79b",
      "bytes": 47619,
      "excerpts": [
        {
          "start": 119,
          "end": 120,
          "lines": [
            "/* Error handling */",
            "lua_err_type *last_lua_error_head = NULL, *last_lua_error_tail = NULL;"
          ]
        },
        {
          "start": 157,
          "end": 218,
          "lines": [
            "void del_lua_error()",
            "{",
            "\tlua_err_type *cur = last_lua_error_head;",
            "\twhile (cur)",
            "\t{",
            "\t\tif (cur->err_msg) free(cur->err_msg);",
            "\t\tif (cur->file) free(cur->file);",
            "\t\tif (cur->func) free(cur->func);",
            "",
            "\t\tlua_err_type *ocur = cur;",
            "\t\tcur = cur->next;",
            "\t\tfree(ocur);",
            "\t}",
            "",
            "\tlast_lua_error_head = NULL;",
            "\tlast_lua_error_tail = NULL;",
            "}",
            "",
            "static void new_lua_error(const char *err)",
            "{",
            "\tdel_lua_error();",
            "",
            "\tlua_err_type *cur = calloc(1, sizeof(lua_err_type));",
            "\tcur->err_msg = strdup(err);",
            "\tcur->next = NULL;",
            "",
            "\tlast_lua_error_head = cur;",
            "\tlast_lua_error_tail = cur;",
            "}",
            "",
            "static void add_lua_error(const char *file, int line, const char *func)",
            "{",
            "\tlua_err_type *cur = calloc(1, sizeof(lua_err_type));",
            "\tcur->err_msg = NULL;",
            "\tcur->file = strdup(file);",
            "\tcur->line = line;",
            "\tcur->func = strdup(func);",
            "\tcur->next = NULL;",
            "",
            "\tlast_lua_error_tail->next = cur;",
            "\tlast_lua_error_tail = cur;",
            "}",
            "",
            "static int traceback (lua_State *L) {",
            "\tlua_Debug ar;",
            "\tint n = 0;",
            "\tprintf(\"Lua Error: %s\\n\", lua_tostring(L, 1));",
            "\twhile(lua_getstack(L, n++, &ar)) {",
            "\t\tlua_getinfo(L, \"nSl\", &ar);",
            "\t\tprintf(\"\\tAt %s:%d %s\\n\", ar.short_src, ar.currentline, ar.name?ar.name:\"\");",
            "\t}",
            "",
            "\t// Do it again for the lua error popup, if needed",
            "\tif (1)",
            "\t{",
            "\t\tn = 0;",
            "\t\tnew_lua_error(lua_tostring(L, 1));",
            "\t\twhile(lua_getstack(L, n++, &ar)) {",
            "\t\t\tlua_getinfo(L, \"nSl\", &ar);",
            "\t\t\tadd_lua_error(ar.short_src, ar.currentline, ar.name?ar.name:\"\");",
            "\t\t}",
            "\t}"
          ]
        },
        {
          "start": 254,
          "end": 276,
          "lines": [
            "",
            "int docall (lua_State *L, int narg, int nret)",
            "{",
            "#if 1",
            "\tint status;",
            "\tint base = lua_gettop(L) - narg;  /* function index */",
            "//\tprintf(\"<===%d (%d)\\n\", base, narg);",
            "\tlua_pushcfunction(L, traceback);  /* push traceback function */",
            "\tlua_insert(L, base);  /* put it under chunk and args */",
            "\tstatus = lua_pcall(L, narg, nret, base);",
            "\tlua_remove(L, base);  /* remove traceback function */",
            "\t/* force a complete garbage collection in case of errors */",
            "\tif (status != 0) { lua_pop(L, 1); lua_gc(L, LUA_GCCOLLECT, 0); }",
            "//\tprintf(\">===%d (%d) [%d]\\n\", lua_gettop(L), nret, status);",
            "\tif (lua_gettop(L) != nret + (base - 1))",
            "\t{",
            "\t\tstackDump(L);",
            "//\t\tassert(0);",
            "\t\tlua_settop(L, base);",
            "\t}",
            "\treturn status;",
            "#else",
            "\tint status=0;"
          ]
        },
        {
          "start": 652,
          "end": 669,
          "lines": [
            "void call_draw(int nb_keyframes)",
            "{",
            "\tif (draw_waiting(L)) return;",
            "",
            "\tif (nb_keyframes > 30) nb_keyframes = 30;",
            "",
            "\t// Notify the particles threads that there are new keyframes",
            "\tif (!anims_paused) thread_particle_new_keyframes(nb_keyframes);",
            "",
            "\tif (current_game != LUA_NOREF)",
            "\t{",
            "\t\tlua_rawgeti(L, LUA_REGISTRYINDEX, current_game);",
            "\t\tlua_pushstring(L, \"display\");",
            "\t\tlua_gettable(L, -2);",
            "\t\tlua_remove(L, -2);",
            "\t\tlua_rawgeti(L, LUA_REGISTRYINDEX, current_game);",
            "\t\tlua_pushnumber(L, (nb_keyframes < 0) ? 0 : nb_keyframes);",
            "\t\tdocall(L, 2, 0);"
          ]
        }
      ]
    },
