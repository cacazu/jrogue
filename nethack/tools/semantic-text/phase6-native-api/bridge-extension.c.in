/* Added 2026-10-02: private typed-event snapshot, NGPL; proposal only.
 * Append inside nh-semantic.c, where its original presentation scope/writer
 * are visible. This copies semantic JSON structure, never English identity.
 */
struct nh_text_scope *nh_text_native_claim(enum nh_text_kind kind,
                                          const char *api, const char *alternate) {
    struct nh_text_scope *scope=(kind==NH_TEXT_MESSAGE && nh_text_forwarded)
                                ? nh_text_forwarded : nh_text_active;
    if (!scope || !scope->descriptor || scope->descriptor->kind!=kind ||
        (strcmp(scope->descriptor->api,api) &&
         (!alternate || strcmp(scope->descriptor->api,alternate)))) return NULL;
    return nh_text_claim(kind);
}

char *nh_text_native_event_copy(const struct nh_text_scope *scope) {
    const char *begin, *cursor;
    size_t length;
    int depth=0, quoted=0, escaped=0;
    char *copy;
    if (!scope || scope->invalid || !scope->json || scope->location || scope->quest ||
        strcmp(scope->variant,"plain") ||
        strncmp(scope->json,"{\"event\":",9)) return NULL;
    begin=scope->json+9;
    if (*begin!='{') return NULL;
    for (cursor=begin;*cursor && (size_t)(cursor-begin)<NH_TEXT_MAX_STRING;++cursor) {
        if (quoted) {
            if (escaped) escaped=0;
            else if (*cursor=='\\') escaped=1;
            else if (*cursor=='"') quoted=0;
            continue;
        }
        if (*cursor=='"') quoted=1;
        else if (*cursor=='{') ++depth;
        else if (*cursor=='}' && --depth==0) {
            length=(size_t)(cursor-begin)+1;
            copy=(char *)malloc(length+1);
            if (!copy) return NULL;
            memcpy(copy,begin,length);copy[length]='\0';return copy;
        }
    }
    return NULL;
}
