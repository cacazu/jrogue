-/*
- * Add a slash to any name not ending in /. There must
- * be room for the /
- */
-void
-append_slash(char *name)
-{
-    char *ptr;
-
-    if (!*name)
-        return;
-    ptr = name + (strlen(name) - 1);
-    if (*ptr != '/') {
-        *++ptr = '/';
-        *++ptr = '\0';
