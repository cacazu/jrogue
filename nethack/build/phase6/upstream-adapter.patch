+    if (length > NH_QUEST_MAX_STRING) { group->invalid=1;return; }
+    for (i=0;i<group->descriptor->count;++i) {
+        const struct nh_quest_binding *b=group->descriptor->bindings+i;
+        if (b->code != code || b->modifier != modifier) continue;
+        if (group->values[i]) {
