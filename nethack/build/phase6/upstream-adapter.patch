+/* Scoped browser ABI for official NetHack 5.0.0; no gameplay mutation.
+ * Modified distribution: added 2026-10-02 for the jrogue browser adapter.
+ * NetHack upstream copyright and NGPL notices remain in upstream/.
+ */
+#include "hack.h"
