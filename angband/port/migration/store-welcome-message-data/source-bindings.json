      "raw_english": "Be sure to set your hitpoint warning in the options menu ('=')."
    },
    {
      "source_ordinal": 20,
      "runtime_list_ordinal": 78,
      "id": "store.welcome.hint.oil_flask_throw_early",
      "raw_english": "Flasks of oil make a good throwing weapon early on."
    },
    {
      "source_ordinal": 21,
      "runtime_list_ordinal": 77,
      "id": "store.welcome.hint.recall_dungeon_return",
      "raw_english": "Word of Recall will send you to and from the dungeon."
    },
    {
      "source_ordinal": 22,
      "runtime_list_ordinal": 76,
      "id": "store.welcome.hint.never_teleport_into_vault",
      "raw_english": "You can never teleport into a vault, even if you're already standing in it. "
    },
    {
      "source_ordinal": 23,
      "runtime_list_ordinal": 75,
      "id": "store.welcome.hint.inventory_only_immunity_protection",
      "raw_english": "The only way to protect your inventory from damage is through immunities."
    },
    {
      "source_ordinal": 24,
      "runtime_list_ordinal": 74,
      "id": "store.welcome.hint.speed_ten_twice_normal",
      "raw_english": "+10 speed means you move twice as fast as normal. "
    },
    {
      "source_ordinal": 25,
      "runtime_list_ordinal": 73,
      "id": "store.welcome.hint.excess_stun_knockout",
      "raw_english": "Too much stunning will knock you out! This is to be avoided if possible."
    },
    {
      "source_ordinal": 26,
      "runtime_list_ordinal": 72,
      "id": "store.welcome.hint.store_stock_changes",
      "raw_english": "The stores change their stock every so often."
    },
    {
      "source_ordinal": 27,
      "runtime_list_ordinal": 71,
      "id": "store.welcome.hint.acid_hits_armor_less_damage",
      "raw_english": "If acid hits your armor, you take less damage from it."
    },
    {
      "source_ordinal": 28,
      "runtime_list_ordinal": 70,
      "id": "store.welcome.hint.nexus_swaps_stats_warning",
      "raw_english": "Nexus attacks can swap your stats. Smart, weak warriors don't do well."
    },
    {
      "source_ordinal": 29,
      "runtime_list_ordinal": 69,
      "id": "store.welcome.hint.regeneration_hp_mana",
      "raw_english": "Regeneration improves your recovery of both hitpoints and mana."
    },
    {
      "source_ordinal": 30,
      "runtime_list_ordinal": 68,
      "id": "store.welcome.hint.do_not_fear_retreat",
      "raw_english": "Never be too afraid to run away."
    },
    {
      "source_ordinal": 31,
      "runtime_list_ordinal": 67,
      "id": "store.welcome.hint.retreat_live_another_day",
      "raw_english": "He who fights and runs away lives to fight another day."
    },
    {
      "source_ordinal": 32,
      "runtime_list_ordinal": 66,
      "id": "store.welcome.hint.explore_with_escape",
      "raw_english": "Never go exploring without an escape option."
    },
    {
      "source_ordinal": 33,
      "runtime_list_ordinal": 65,
      "id": "store.welcome.hint.watch_enemy_movement",
      "raw_english": "Pay attention to how your enemies move - some are erratic, some can blink."
    },
    {
      "source_ordinal": 34,
      "runtime_list_ordinal": 64,
      "id": "store.welcome.hint.same_type_speed_varies",
      "raw_english": "Even among the same type, some enemies will be faster or slower than others."
    },
    {
      "source_ordinal": 35,
      "runtime_list_ordinal": 63,
      "id": "store.welcome.hint.wounded_breath_weaker",
      "raw_english": "Monsters' breath weapons grow less dangerous as they lose hitpoints."
    },
    {
      "source_ordinal": 36,
      "runtime_list_ordinal": 62,
      "id": "store.welcome.hint.wounded_spells_same_strength",
      "raw_english": "A wounded enemy's spells are as strong as a healthy one's."
    },
    {
      "source_ordinal": 37,
      "runtime_list_ordinal": 61,
      "id": "store.welcome.hint.use_resources_to_survive",
      "raw_english": "Don't worry about using up your potions, wands, and staves to stay alive."
    },
    {
      "source_ordinal": 38,
      "runtime_list_ordinal": 60,
      "id": "store.welcome.hint.bad_situation_inspect_gear",
      "raw_english": "If you're in a bad situation, take a breather and \"I\"nspect all your gear."
    },
    {
      "source_ordinal": 39,
      "runtime_list_ordinal": 59,
      "id": "store.welcome.hint.death_passes_monster_memories",
      "raw_english": "When a character dies, memories of monsters she has fought are passed on."
    },
    {
      "source_ordinal": 40,
      "runtime_list_ordinal": 58,
      "id": "store.welcome.hint.blindness_disables_powerful",
      "raw_english": "Even the most powerful characters can be made useless by blindness."
    },
    {
      "source_ordinal": 41,
      "runtime_list_ordinal": 57,
      "id": "store.welcome.hint.confusion_disables_powerful",
      "raw_english": "Even the most powerful characters can be made useless by confusion."
    },
    {
      "source_ordinal": 42,
      "runtime_list_ordinal": 56,
      "id": "store.welcome.hint.resist_blind_confused_survival",
      "raw_english": "Finding a way to resist blindness and confusion is critical to survival."
    },
    {
      "source_ordinal": 43,
      "runtime_list_ordinal": 55,
      "id": "store.welcome.hint.probing_always_useful",
      "raw_english": "Probing an enemy to learn its abilities is always useful."
    },
    {
      "source_ordinal": 44,
      "runtime_list_ordinal": 54,
      "id": "store.welcome.hint.buy_phase_door_before_dungeon",
      "raw_english": "Buy at least one scroll of phase door before you enter the dungeon."
    },
    {
      "source_ordinal": 45,
      "runtime_list_ordinal": 53,
      "id": "store.welcome.hint.buy_light_wounds_before_dungeon",
      "raw_english": "Buy at least one potion of cure light wounds before you enter the dungeon."
    },
    {
      "source_ordinal": 46,
      "runtime_list_ordinal": 52,
      "id": "store.welcome.hint.acid_water_hounds_vortices",
      "raw_english": "Acid can destroy your stuff - watch out for water hounds and water vortices."
    },
    {
      "source_ordinal": 47,
      "runtime_list_ordinal": 51,
      "id": "store.welcome.hint.do_not_underestimate_unknown",
      "raw_english": "Never underestimate monsters you haven't fought before."
    },
    {
      "source_ordinal": 48,
      "runtime_list_ordinal": 50,
      "id": "store.welcome.hint.quiver_mixed_ammo_forty",
      "raw_english": "Quivers can hold different types of ammo in one inventory slot (max. 40)."
    },
    {
      "source_ordinal": 49,
      "runtime_list_ordinal": 49,
      "id": "store.welcome.hint.quiver_over_forty_slots",
      "raw_english": "If you have more than 40 items in your quiver, it will take up more slots."
    },
    {
      "source_ordinal": 50,
      "runtime_list_ordinal": 48,
      "id": "store.welcome.hint.throw_weapon_inscription",
      "raw_english": "Try inscribing thrown weapons, \"@v0\" for example."
    },
    {
      "source_ordinal": 51,
      "runtime_list_ordinal": 47,
      "id": "store.welcome.hint.bad_items_few_magic_curses",
      "raw_english": "Many items are bad, but few are cursed to the point of needing magic."
    },
    {
      "source_ordinal": 52,
      "runtime_list_ordinal": 46,
      "id": "store.welcome.hint.bigger_weapon_not_always_better",
      "raw_english": "A bigger weapon isn't always better - check your damage using 'I'nspect"
    },
    {
      "source_ordinal": 53,
      "runtime_list_ordinal": 45,
      "id": "store.welcome.hint.extra_windows_information",
      "raw_english": "Can't keep track of all the information on the screen? Add extra windows."
    },
    {
      "source_ordinal": 54,
      "runtime_list_ordinal": 44,
      "id": "store.welcome.hint.subwindow_messages_monsters_items",
      "raw_english": "You can use subwindows to display messages, monsters, items and more."
    },
    {
      "source_ordinal": 55,
      "runtime_list_ordinal": 43,
      "id": "store.welcome.hint.teleported_enemy_later_teleport",
      "raw_english": "If you teleport away a tough monster, beware of teleporting afterwards!"
    },
    {
      "source_ordinal": 56,
      "runtime_list_ordinal": 42,
      "id": "store.welcome.hint.higher_resistance_reduction",
      "raw_english": "Resistance to higher elements protects you from 33% to 50% of the damage."
    },
    {
      "source_ordinal": 57,
      "runtime_list_ordinal": 41,
      "id": "store.welcome.hint.hold_life_not_all_drain",
      "raw_english": "Hold life will not block all experience drain, just most of it."
    },
    {
      "source_ordinal": 58,
      "runtime_list_ordinal": 40,
      "id": "store.welcome.hint.fire_destroys_scroll_book_staff",
      "raw_english": "Fire damage can destroy scrolls, books, and staves in your inventory."
    },
    {
      "source_ordinal": 59,
      "runtime_list_ordinal": 39,
      "id": "store.welcome.hint.cold_destroys_potions",
      "raw_english": "Cold damage can destroy potions in your inventory."
    },
    {
      "source_ordinal": 60,
      "runtime_list_ordinal": 38,
      "id": "store.welcome.hint.electricity_destroys_devices_rings",
      "raw_english": "Electrical damage can destroy wands, rods and rings in your inventory."
    },
    {
      "source_ordinal": 61,
      "runtime_list_ordinal": 37,
      "id": "store.welcome.hint.immunity_prevents_inventory_destruction",
      "raw_english": "Immunity to an element prevents inventory destruction from that element."
    },
    {
      "source_ordinal": 62,
      "runtime_list_ordinal": 36,
      "id": "store.welcome.hint.phase_door_suitable_terrain",
      "raw_english": "Phase door is a good escape if the terrain is appropriate."
    },
    {
      "source_ordinal": 63,
      "runtime_list_ordinal": 35,
      "id": "store.welcome.hint.phase_door_open_room_line_fire",
      "raw_english": "In open rooms Phase Door may well keep you in the line of fire."
    },
    {
      "source_ordinal": 64,
      "runtime_list_ordinal": 34,
      "id": "store.welcome.hint.vault_teleport_always_outside",
      "raw_english": "In a vault, any form of teleportation will always teleport you outside."
    },
    {
      "source_ordinal": 65,
      "runtime_list_ordinal": 33,
      "id": "store.welcome.hint.equipment_same_resists_no_stack",
      "raw_english": "Identical resistances on different pieces of equipment do not stack."
    },
    {
      "source_ordinal": 66,
      "runtime_list_ordinal": 32,
      "id": "store.welcome.hint.curing_cuts_stun_poison",
      "raw_english": "Curing potions and spells can reduce or eliminate cuts, stunning and poison."
    },
    {
      "source_ordinal": 67,
      "runtime_list_ordinal": 31,
      "id": "store.welcome.hint.nexus_four_effects",
      "raw_english": "Nexus attacks can teleport to, teleport away, teleport level, or swap stats."
    },
    {
      "source_ordinal": 68,
      "runtime_list_ordinal": 30,
      "id": "store.welcome.hint.time_not_mitigated_sustains",
      "raw_english": "Time attacks are not mitigated by sustains."
    },
    {
      "source_ordinal": 69,
      "runtime_list_ordinal": 29,
      "id": "store.welcome.hint.drain_charges_heals_monster",
      "raw_english": "Drain charge attacks remove charges from your items and heal the monster!"
    },
    {
      "source_ordinal": 70,
      "runtime_list_ordinal": 28,
      "id": "store.welcome.hint.wall_monster_ranged_asymmetry",
      "raw_english": "You cannot cast spells or fire missiles at monsters in walls, but they can."
    },
    {
      "source_ordinal": 71,
      "runtime_list_ordinal": 27,
      "id": "store.welcome.hint.wall_monster_melee_allowed",
      "raw_english": "You can attack a monster in a wall with your melee weapon."
    },
    {
      "source_ordinal": 72,
      "runtime_list_ordinal": 26,
      "id": "store.welcome.hint.acquirement_better_deeper",
      "raw_english": "Acquirement scrolls produce better items if you read them deeper down."
    },
    {
      "source_ordinal": 73,
      "runtime_list_ordinal": 25,
      "id": "store.welcome.hint.desperate_level_teleport_destruction",
      "raw_english": "In truly desperate times, use Teleport Level or Destruction to escape."
    },
    {
      "source_ordinal": 74,
      "runtime_list_ordinal": 24,
      "id": "store.welcome.hint.first_move_entering_level",
      "raw_english": "You always get the first move when entering a level. "
    },
    {
      "source_ordinal": 75,
      "runtime_list_ordinal": 23,
      "id": "store.welcome.hint.regeneration_hunger_faster",
      "raw_english": "Regeneration makes you hungry more quickly."
    },
    {
      "source_ordinal": 76,
      "runtime_list_ordinal": 22,
      "id": "store.welcome.hint.curing_food_emergency",
      "raw_english": "If you're in extreme need of food, curing potions might do you good."
    },
    {
      "source_ordinal": 77,
      "runtime_list_ordinal": 21,
      "id": "store.welcome.hint.heavy_loot_slows",
      "raw_english": "Under great weights of loot, you'll be less quick of foot."
    },
    {
      "source_ordinal": 78,
      "runtime_list_ordinal": 20,
      "id": "store.welcome.hint.never_invincible",
      "raw_english": "You're never invincible. Never forget that."
    },
    {
      "source_ordinal": 79,
      "runtime_list_ordinal": 19,
      "id": "store.welcome.hint.escape_blind_confused",
      "raw_english": "Always carry around an escape that you can use while blind and confused."
    },
    {
      "source_ordinal": 80,
      "runtime_list_ordinal": 18,
      "id": "store.welcome.hint.linger_spawns_awake_monsters",
      "raw_english": "Staying on a level too long can cause awake random monsters to spawn."
    },
    {
      "source_ordinal": 81,
      "runtime_list_ordinal": 17,
      "id": "store.welcome.hint.empty_devices_sell_well",
      "raw_english": "Wands and staves sell for a good price even with 0 charges."
    },
    {
      "source_ordinal": 82,
      "runtime_list_ordinal": 16,
      "id": "store.welcome.hint.many_heavy_weapons_unwise",
      "raw_english": "Walking around with lots of heavy weapons is not necessarily a good idea."
    },
    {
      "source_ordinal": 83,
      "runtime_list_ordinal": 15,
      "id": "store.welcome.hint.spare_town_spellbooks_fire",
      "raw_english": "Carry around extra copies of town spellbooks in case one gets burned."
    },
    {
      "source_ordinal": 84,
      "runtime_list_ordinal": 14,
      "id": "store.welcome.hint.swap_resistance_items",
      "raw_english": "You don't have to cover every resist all the time - carry swap items."
    },
    {
      "source_ordinal": 85,
      "runtime_list_ordinal": 13,
      "id": "store.welcome.hint.well_fed_hp_recovery",
      "raw_english": "The better fed you are, the faster you recover hitpoints."
    },
    {
      "source_ordinal": 86,
      "runtime_list_ordinal": 12,
      "id": "store.welcome.hint.food_indicator",
      "raw_english": "The food indicator at the bottom of the screen shows how well fed you are."
    },
    {
      "source_ordinal": 87,
      "runtime_list_ordinal": 11,
      "id": "store.welcome.hint.light_meter_radius",
      "raw_english": "The light meter at the bottom of the screen shows your light radius."
    },
    {
      "source_ordinal": 88,
      "runtime_list_ordinal": 10,
      "id": "store.welcome.hint.store_no_buy_birth_options",
      "raw_english": "If stores will not buy your items, check your birth options."
    },
    {
      "source_ordinal": 89,
      "runtime_list_ordinal": 9,
      "id": "store.welcome.hint.blackguard_open_wounds_recovery",
      "raw_english": "Blackguards can use Rings of Open Wounds without slowing their recovery."
    },
    {
      "source_ordinal": 90,
      "runtime_list_ordinal": 8,
      "id": "store.welcome.hint.stunned_monster_damage_turn",
      "raw_english": "Stunned monsters deal less damage in melee and sometimes miss a turn."
    },
    {
      "source_ordinal": 91,
      "runtime_list_ordinal": 7,
      "id": "store.welcome.hint.confused_monster_cast_misstep",
      "raw_english": "Confused monsters cannot cast spells reliably and may misstep."
    },
    {
      "source_ordinal": 92,
      "runtime_list_ordinal": 6,
      "id": "store.welcome.hint.scared_monster_cornered_freeze",
      "raw_english": "Scared monsters suffer penalties and may freeze in terror if cornered!"
    },
    {
      "source_ordinal": 93,
      "runtime_list_ordinal": 5,
      "id": "store.welcome.hint.held_monster_no_action",
      "raw_english": "Held monsters will take no action until it wears off or they take damage."
    },
    {
      "source_ordinal": 94,
      "runtime_list_ordinal": 4,
      "id": "store.welcome.hint.wake_sleepers_melee_damage_effects",
      "raw_english": "Melee attacks, damage, and some effects will wake sleeping monsters."
    },
    {
      "source_ordinal": 95,
      "runtime_list_ordinal": 3,
      "id": "store.welcome.hint.wake_sleepers_sight_hearing_time",
      "raw_english": "Time spent within sight or hearing range will eventually wake sleepers."
    },
    {
      "source_ordinal": 96,
      "runtime_list_ordinal": 2,
      "id": "store.welcome.hint.stealth_sleeping_not_alert",
      "raw_english": "Stealth is very helpful against sleeping monsters but not against alert ones."
    },
    {
      "source_ordinal": 97,
      "runtime_list_ordinal": 1,
      "id": "store.welcome.hint.inspect_race_class_abilities",
      "raw_english": "Inspect your racial and class abilities with the S command."
    },
    {
      "source_ordinal": 98,
      "runtime_list_ordinal": 0,
      "id": "store.welcome.hint.shape_inspect_resume_commands",
      "raw_english": "When shapechanged inspect items with I. Resume your shape with m or p."
    }
  ],
