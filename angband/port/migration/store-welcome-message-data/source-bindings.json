      "runtime_list_ordinal": 93,
      "id": "store.welcome.hint.monster_hp_increases_breath",
      "raw_english": "The more hitpoints a monster has, the more damage its breath will do."
    },
    {
      "source_ordinal": 6,
      "runtime_list_ordinal": 92,
      "id": "store.welcome.hint.combine_fire_resistance",
      "raw_english": "You can combine equipment of Resist Fire and a potion of the same name."
    },
    {
      "source_ordinal": 7,
      "runtime_list_ordinal": 91,
      "id": "store.welcome.hint.combine_cold_resistance",
      "raw_english": "You can combine equipment of Resist Cold and a potion of the same name."
    },
    {
      "source_ordinal": 8,
      "runtime_list_ordinal": 90,
      "id": "store.welcome.hint.combine_poison_resistance",
      "raw_english": "You can combine equipment of Resist Poison and a potion of the same name."
    },
    {
      "source_ordinal": 9,
      "runtime_list_ordinal": 89,
      "id": "store.welcome.hint.probe_unknown_monster",
      "raw_english": "If you don't know what a monster can do, use a rod of probing on it."
    },
    {
