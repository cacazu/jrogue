+++ b/src/cdda_help_semantic.h
@@ -0,0 +1,146 @@
+// Source-only preparation against CDDA 0.I-1. CC BY-SA 3.0; see ../NOTICE.md.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
