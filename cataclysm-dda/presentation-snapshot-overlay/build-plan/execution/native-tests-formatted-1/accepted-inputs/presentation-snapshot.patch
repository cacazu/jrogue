diff --git a/src/browser_text_snapshot.h b/src/browser_text_snapshot.h
new file mode 100644
--- /dev/null
+++ b/src/browser_text_snapshot.h
@@ -0,0 +1,39 @@
+// Source-only original CDDA text-presentation observer. See ../NOTICE.md.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+namespace catacurses { class window; }
+class Font;
+struct point;
+
+enum class cdda_text_font_role : uint32_t { ui = 1, map = 2, overmap = 3, unknown = 4 };
+
+// Called only by original SDL producers on the existing engine thread.
+// Views are copied synchronously; no native pointer is retained or exported.
+void cdda_text_observe_window( const catacurses::window &window, const Font &font,
+                              cdda_text_font_role role, const point &glyph_offset,
+                              const point &clip_size, int scaling_factor,
+                              bool ascii_lines_option ) noexcept;
+// Original refresh_display calls this only after restoring display_buffer.
+// This publishes an ordered text-submission batch, never a complete canvas.
+void cdda_text_present_committed() noexcept;
+
+extern "C" {
+#define CDDA_TEXT_NOEXCEPT noexcept
+#else
+#define CDDA_TEXT_NOEXCEPT
+#endif
+
+// Independent family: cdda-native-text-submissions/1, notice kind 2.
+// Immutable historical bytes; no input, redraw, RNG or simulation export.
+uint32_t cdda_text_snapshot_pin( void ) CDDA_TEXT_NOEXCEPT;
+const uint8_t *cdda_text_snapshot_data( uint32_t handle ) CDDA_TEXT_NOEXCEPT;
+size_t cdda_text_snapshot_size( uint32_t handle ) CDDA_TEXT_NOEXCEPT;
+void cdda_text_snapshot_release( uint32_t handle ) CDDA_TEXT_NOEXCEPT;
+
+#ifdef __cplusplus
+}
+#endif
+#undef CDDA_TEXT_NOEXCEPT
diff --git a/src/browser_text_snapshot.cpp b/src/browser_text_snapshot.cpp
new file mode 100644
--- /dev/null
+++ b/src/browser_text_snapshot.cpp
@@ -0,0 +1,243 @@
+// Uncompiled source-only preparation; original CDDA CC BY-SA 3.0 notices retained.
+#include "browser_text_snapshot.h"
+
+#if defined(TILES) && !defined(IMTUI)
+#include <array>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "catacharset.h"
+#include "cursesdef.h"
+#include "cursesport.h"
+#include "output.h"
+#include "point.h"
+#include "sdl_font.h"
+
+#ifndef CDDA_TEXT_SNAPSHOT_BUILD_ID
+#error "an explicit coordinated integration build identity is required"
+#endif
+
+#ifdef EMSCRIPTEN
+#include <emscripten.h>
+#define CDDA_TEXT_EXPORT EMSCRIPTEN_KEEPALIVE
+EM_JS( void, cdda_text_notify, ( uint32_t low, uint32_t high, uint32_t availability ), {
+    try {
+        const notice = Object.freeze( { kind: 2, publicationLow: low >>> 0,
+            publicationHigh: high >>> 0, availability: availability >>> 0 } );
+        const deliver = () => {
+            try {
+                const receive = globalThis.cddaTextSnapshotAvailable;
+                if( typeof receive === 'function' ) { receive( notice ); }
+            } catch( ignored ) { }
+        };
+        if( typeof queueMicrotask === 'function' ) { queueMicrotask( deliver ); }
+        else { Promise.resolve().then( deliver ).catch( () => {} ); }
+    } catch( ignored ) { }
+} );
+#else
+#define CDDA_TEXT_EXPORT
+static void cdda_text_notify( uint32_t, uint32_t, uint32_t ) { }
+#endif
+
+namespace
+{
+using bytes = std::vector<uint8_t>;
+constexpr size_t max_bytes = 4 * 1024 * 1024;
+constexpr size_t max_cell_bytes = 4096;
+constexpr uint32_t max_cells = 65536;
+constexpr uint32_t max_windows = 64;
+constexpr uint32_t max_axis = 1024;
+constexpr uint32_t max_pins = 4;
+constexpr char source_commit[] = "7b2efa5cea38e4d4d97dd0e63b28b9148623da59";
+constexpr char build_id[] = CDDA_TEXT_SNAPSHOT_BUILD_ID;
+static_assert( sizeof( build_id ) > 1 && sizeof( build_id ) <= 257, "nonempty build identity up to 256 bytes" );
+static_assert( std::numeric_limits<int>::digits == 31, "observed native int fields are signed 32-bit" );
+static_assert( std::numeric_limits<short>::digits == 15, "observed native base_color has 16-bit storage" );
+static_assert( color_loader<SDL_Color>::COLOR_NAMES_COUNT == 16, "pinned palette has 16 colors" );
+
+// Sidecar ownership only. Never owns native windows, input, a clock or RNG.
+bytes pending;
+uint32_t pending_windows = 0;
+uint32_t pending_cells = 0;
+bool pending_failed = false;
+bool inside_observer = false;
+uint64_t publication = 0;
+std::shared_ptr<const bytes> latest;
+struct pin_slot { uint32_t handle = 0; std::shared_ptr<const bytes> data; };
+std::array<pin_slot, max_pins> pins;
+uint32_t next_handle = 1;
+bool handles_exhausted = false;
+
+struct observer_scope {
+    observer_scope() { inside_observer = true; }
+    ~observer_scope() { inside_observer = false; }
+};
+
+void append_raw( bytes &out, const void *data, size_t size )
+{
+    if( size > max_bytes - out.size() ) { throw std::length_error( "text observation cap" ); }
+    if( size == 0 ) { return; } // empty vector/string data may be null
+    const auto *first = static_cast<const uint8_t *>( data );
+    out.insert( out.end(), first, first + size );
+}
+void u8( bytes &out, uint8_t value ) { append_raw( out, &value, 1 ); }
+void u16( bytes &out, uint16_t value )
+{
+    u8( out, static_cast<uint8_t>( value ) );
+    u8( out, static_cast<uint8_t>( value >> 8 ) );
+}
+void u32( bytes &out, uint32_t value )
+{
+    for( unsigned shift = 0; shift < 32; shift += 8 ) { u8( out, static_cast<uint8_t>( value >> shift ) ); }
+}
+void i32( bytes &out, int value ) { u32( out, static_cast<uint32_t>( value ) ); }
+void u64( bytes &out, uint64_t value )
+{
+    u32( out, static_cast<uint32_t>( value ) ); u32( out, static_cast<uint32_t>( value >> 32 ) );
+}
+void raw_string( bytes &out, const std::string &value )
+{
+    if( value.size() > max_cell_bytes ) { throw std::length_error( "raw cell cap" ); }
+    u32( out, static_cast<uint32_t>( value.size() ) ); append_raw( out, value.data(), value.size() );
+}
+
+void encode_cell( bytes &out, const cata_cursesport::cursecell &cell, bool lines_option )
+{
+    // Raw border bytes 0xa0..0xaa are legal native data, not UTF-8 prose.
+    raw_string( out, cell.ch );
+    u16( out, static_cast<uint16_t>( static_cast<short>( cell.FG ) ) );
+    u16( out, static_cast<uint16_t>( static_cast<short>( cell.BG ) ) );
+    const uint32_t codepoint = cell.ch.empty() ? 0 : UTF8_getch( cell.ch );
+    const int width = cell.ch.empty() ? 0 : ( codepoint == UNKNOWN_UNICODE ? 1 : utf8_width( cell.ch, false ) );
+    u32( out, codepoint ); i32( out, width );
+    bool lines = lines_option;
+    uint8_t line_id = cell.ch.empty() ? 0 : static_cast<uint8_t>( cell.ch[0] );
+    switch( codepoint ) {
+        case LINE_XOXO_UNICODE: line_id = LINE_XOXO_C; break;
+        case LINE_OXOX_UNICODE: line_id = LINE_OXOX_C; break;
+        case LINE_XXOO_UNICODE: line_id = LINE_XXOO_C; break;
+        case LINE_OXXO_UNICODE: line_id = LINE_OXXO_C; break;
+        case LINE_OOXX_UNICODE: line_id = LINE_OOXX_C; break;
+        case LINE_XOOX_UNICODE: line_id = LINE_XOOX_C; break;
+        case LINE_XXXO_UNICODE: line_id = LINE_XXXO_C; break;
+        case LINE_XXOX_UNICODE: line_id = LINE_XXOX_C; break;
+        case LINE_XOXX_UNICODE: line_id = LINE_XOXX_C; break;
+        case LINE_OXXX_UNICODE: line_id = LINE_OXXX_C; break;
+        case LINE_XXXX_UNICODE: line_id = LINE_XXXX_C; break;
+        case UNKNOWN_UNICODE: lines = true; break;
+        default: lines = false; break;
+    }
+    // The consumer must still preserve native empty/space/width<1 early exits.
+    u8( out, lines ? 1 : 0 ); u8( out, line_id );
+}
+
+void unavailable_batch() noexcept
+{
+    pending.clear(); pending_windows = 0; pending_cells = 0; pending_failed = true;
+    latest.reset();
+}
+} // namespace
+
+void cdda_text_observe_window( const catacurses::window &window, const Font &font,
+                              cdda_text_font_role role, const point &glyph_offset,
+                              const point &clip_size, int scaling_factor,
+                              bool ascii_lines_option ) noexcept
+{
+    if( inside_observer || pending_failed ) { return; }
+    observer_scope scope;
+    try {
+        // catacurses::window::get() const returns a mutable pointer; explicitly
+        // bind const so this observer cannot clear native damage/cursor state.
+        const auto *native = window.get<cata_cursesport::WINDOW>();
+        if( !native ) { throw std::runtime_error( "missing native window" ); }
+        const cata_cursesport::WINDOW &win = *native;
+        if( win.width <= 0 || win.height <= 0 || win.width > static_cast<int>( max_axis ) ||
+            win.height > static_cast<int>( max_axis ) || font.width <= 0 || font.height <= 0 ||
+            clip_size.x <= 0 || clip_size.y <= 0 || scaling_factor <= 0 ||
+            win.line.size() != static_cast<size_t>( win.height ) || pending_windows == max_windows ) {
+            throw std::runtime_error( "unsupported window shape" );
+        }
+        const uint32_t cells = static_cast<uint32_t>( win.width ) * static_cast<uint32_t>( win.height );
+        if( cells > max_cells - pending_cells ) { throw std::length_error( "frame cell cap" ); }
+        bytes record;
+        u32( record, static_cast<uint32_t>( role ) );
+        for( const int field : {win.pos.x, win.pos.y, win.width, win.height, win.cursor.x, win.cursor.y,
+                               font.width, font.height, glyph_offset.x, glyph_offset.y,
+                               clip_size.x, clip_size.y, scaling_factor} ) { i32( record, field ); }
+        u8( record, win.inuse ? 1 : 0 ); u8( record, win.draw ? 1 : 0 );
+        u8( record, ascii_lines_option ? 1 : 0 ); u8( record, 0 );
+        u16( record, static_cast<uint16_t>( static_cast<short>( win.FG ) ) );
+        u16( record, static_cast<uint16_t>( static_cast<short>( win.BG ) ) );
+        for( const SDL_Color &color : font.palette ) {
+            for( const uint8_t channel : {color.r, color.g, color.b, color.a} ) { u8( record, channel ); }
+        }
+        for( const cata_cursesport::curseline &row : win.line ) {
+            if( row.chars.size() != static_cast<size_t>( win.width ) ) { throw std::runtime_error( "row shape" ); }
+            u8( record, row.touched ? 1 : 0 );
+            for( const cata_cursesport::cursecell &cell : row.chars ) { encode_cell( record, cell, ascii_lines_option ); }
+        }
+        u32( pending, static_cast<uint32_t>( record.size() ) );
+        append_raw( pending, record.data(), record.size() );
+        ++pending_windows; pending_cells += cells;
+    } catch( ... ) { unavailable_batch(); }
+}
+
+void cdda_text_present_committed() noexcept
+{
+    if( inside_observer ) { return; }
+    observer_scope scope;
+    if( publication == std::numeric_limits<uint64_t>::max() ) {
+        unavailable_batch(); cdda_text_notify( 0, 0, 3 ); return;
+    }
+    ++publication;
+    uint32_t availability = 1;
+    try {
+        if( pending_failed ) { throw std::runtime_error( "failed text submission batch" ); }
+        bytes output;
+        append_raw( output, "CDTP", 4 ); u16( output, 1 );
+        u16( output, 0 ); // full_canvas_complete is ALWAYS false in phase one.
+        u64( output, publication ); append_raw( output, source_commit, 40 );
+        u32( output, sizeof( build_id ) - 1 ); append_raw( output, build_id, sizeof( build_id ) - 1 );
+        u32( output, pending_windows ); append_raw( output, pending.data(), pending.size() );
+        latest = std::make_shared<const bytes>( std::move( output ) );
+    } catch( ... ) { latest.reset(); availability = 2; }
+    pending.clear(); pending_windows = 0; pending_cells = 0; pending_failed = false;
+    cdda_text_notify( static_cast<uint32_t>( publication ), static_cast<uint32_t>( publication >> 32 ), availability );
+}
+
+extern "C" CDDA_TEXT_EXPORT uint32_t cdda_text_snapshot_pin() noexcept
+{
+    if( inside_observer || !latest || handles_exhausted ) { return 0; }
+    for( pin_slot &slot : pins ) {
+        if( slot.handle == 0 ) {
+            const uint32_t handle = next_handle;
+            if( next_handle == std::numeric_limits<uint32_t>::max() ) { handles_exhausted = true; }
+            else { ++next_handle; }
+            slot.data = latest; slot.handle = handle; return handle;
+        }
+    }
+    return 0;
+}
+extern "C" CDDA_TEXT_EXPORT const uint8_t *cdda_text_snapshot_data( uint32_t handle ) noexcept
+{
+    if( inside_observer || handle == 0 ) { return nullptr; }
+    for( const pin_slot &slot : pins ) { if( slot.handle == handle ) { return slot.data->data(); } }
+    return nullptr;
+}
+extern "C" CDDA_TEXT_EXPORT size_t cdda_text_snapshot_size( uint32_t handle ) noexcept
+{
+    if( inside_observer || handle == 0 ) { return 0; }
+    for( const pin_slot &slot : pins ) { if( slot.handle == handle ) { return slot.data->size(); } }
+    return 0;
+}
+extern "C" CDDA_TEXT_EXPORT void cdda_text_snapshot_release( uint32_t handle ) noexcept
+{
+    if( inside_observer || handle == 0 ) { return; }
+    for( pin_slot &slot : pins ) {
+        if( slot.handle == handle ) { slot.data.reset(); slot.handle = 0; return; }
+    }
+}
+#endif // TILES && !IMTUI
