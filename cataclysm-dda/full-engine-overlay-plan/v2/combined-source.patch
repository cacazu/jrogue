-void tileset_cache::loader::load_layers( const JsonObject &config )
-{
-    for( const JsonObject item : config.get_array( "variants" ) ) {
-        if( item.has_member( "context" ) && ( item.has_array( "item_variants" ) ||
-                                              item.has_array( "field_variants" ) ) ) {
-
-            std::string context;
