+std::optional<cdda_help_semantic::topic_metadata> help::observe_loaded_topic( const int order ) const noexcept
+{
+    try {
+        const auto found = semantic_help_topics.find( order );
+        if( found != semantic_help_topics.end() ) { return found->second; }
+    } catch( ... ) {}
+    return std::nullopt;
+}
