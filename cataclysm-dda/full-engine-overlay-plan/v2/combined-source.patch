-static std::unordered_map<point_abs_omt, bool> generated_omts;
-
-bool is_generated_omt( const point_abs_omt &omp )
-{
-    if( const auto it = generated_omts.find( omp ); it != generated_omts.end() ) {
-        return it->second;
-    }
