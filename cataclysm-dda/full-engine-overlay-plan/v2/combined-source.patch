-std::optional<point> cata_tiles::tile_to_player( const point &colrow ) const
-{
-    std::optional<point_bub_ms> ret = tile_to_player(
-                                          colrow, point_bub_ms( o ),
-                                          point( screentile_width, screentile_height ), is_isometric() );
