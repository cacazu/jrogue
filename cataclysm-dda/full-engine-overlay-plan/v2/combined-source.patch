+                return draw_from_id_string( ZOMBIE_REVIVAL_INDICATOR, TILE_CATEGORY::NONE,
+                                            empty_string, pos, 0, 0, lit_level::LIT, false, height_3d );
+            }
+        }
+    }
+    return false;
+}
