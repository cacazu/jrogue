-template<typename T>
-std::optional<tile_lookup_res>
-cata_tiles::find_tile_looks_like_by_string_id( std::string_view id, TILE_CATEGORY category,
-        const int looks_like_jumps_limit ) const
-{
-    const string_id<T> s_id( id );
-    if( !s_id.is_valid() ) {
-        return std::nullopt;
-    }
