-             || action == "DOWN"
-             || action == "LEFT"
-             || action == "RIGHT"
-             || action == "LEFTUP"
-             || action == "LEFTDOWN"
-             || action == "RIGHTUP"
-             || action == "RIGHTDOWN"
-             || action == "QUIT"
-             || action == "CONFIRM"
-             || action == "MOVE_SINGLE_ITEM" // maps to ENTER
-             || action == "MOVE_ARMOR" // maps to ENTER
