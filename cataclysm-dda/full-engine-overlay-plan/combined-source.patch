+//Ends the terminal, destroy everything
+void catacurses::endwin()
+{
+    tilecontext.reset();
+    closetilecontext.reset();
+    fartilecontext.reset();
+    overmap_tilecontext.reset();
+    font.reset();
+    gui_font.reset();
+    map_font.reset();
+    overmap_font.reset();
+    ui_manager::reset();
+    WinDestroy();
+}
