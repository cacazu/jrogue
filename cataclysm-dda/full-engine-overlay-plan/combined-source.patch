-static int alt_buffer = 0;
-static bool alt_down = false;
-
-static void begin_alt_code()
-{
-    alt_buffer = 0;
-    alt_down = true;
-}
-
-static bool add_alt_code( char c )
-{
-    if( alt_down && c >= '0' && c <= '9' ) {
-        alt_buffer = alt_buffer * 10 + ( c - '0' );
-        return true;
-    }
-    return false;
-}
