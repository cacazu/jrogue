+bool is_keycode_mode_supported()
+{
+#if defined(TILES) && !defined(__ANDROID__) && !(defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE == 1)
+    return keycode_mode;
+#else
+    return false;
+#endif
