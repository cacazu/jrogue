{"op":"eval","expression":"(async()=>{const FS=Module.FS;const path='/lang/mo/ja/LC_MESSAGES/cataclysm-dda.mo';let bytes;try{bytes=FS.readFile(path)}catch(error){return {path,error:String(error),root:FS.readdir('/')}}const hash=new Uint8Array(await crypto.subtle.digest('SHA-256',bytes));return {path,size:bytes.length,magic:Array.from(bytes.slice(0,12)),sha256:Array.from(hash,x=>x.toString(16).padStart(2,'0')).join(''),nodeKeys:Object.keys(FS.analyzePath(path).object)}})()"}
