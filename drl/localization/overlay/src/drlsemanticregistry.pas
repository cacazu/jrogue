function DRLRegistryText(const aCategory, aRegistryID, aScope, aField, aEnglish: AnsiString): AnsiString;
var i: Integer;
begin
  for i := 0 to High(CRegistryFields) do
    with CRegistryFields[i] do
      if (Category = aCategory) and (RegistryID = aRegistryID) and
         (Scope = aScope) and (Field = aField) then
      begin
        if English <> aEnglish then Exit(aEnglish);
        Exit(DRLText(ID, aEnglish));
      end;
  Exit(aEnglish);
end;
end.
