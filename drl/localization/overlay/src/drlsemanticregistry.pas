  (Category: 'rank'; RegistryID: 'skill:23'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.skill.chaos-major-general.name'; English: 'Chaos Mjr General'),
  (Category: 'rank'; RegistryID: 'skill:24'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.skill.chaos-lieutenant-general.name'; English: 'Chaos Lt. General'),
  (Category: 'rank'; RegistryID: 'skill:25'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.skill.chaos-general.name'; English: 'Chaos General'),
  (Category: 'rank'; RegistryID: 'skill:26'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.skill.chaos-marshal.name'; English: 'Chaos Marshal'),
  (Category: 'rank'; RegistryID: 'skill:27'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.skill.no-life-king.name'; English: 'No-Life King'),
  (Category: 'rank'; RegistryID: 'exp:1'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.human.name'; English: 'Human'),
  (Category: 'rank'; RegistryID: 'exp:2'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.former-human.name'; English: 'Former Human'),
  (Category: 'rank'; RegistryID: 'exp:3'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.imp.name'; English: 'Imp'),
  (Category: 'rank'; RegistryID: 'exp:4'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.demon.name'; English: 'Demon'),
  (Category: 'rank'; RegistryID: 'exp:5'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.cacodemon.name'; English: 'Cacodemon'),
  (Category: 'rank'; RegistryID: 'exp:6'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.mancubus.name'; English: 'Mancubus'),
  (Category: 'rank'; RegistryID: 'exp:7'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.hell-knight.name'; English: 'Hell Knight'),
  (Category: 'rank'; RegistryID: 'exp:8'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.hell-baron.name'; English: 'Hell Baron'),
  (Category: 'rank'; RegistryID: 'exp:9'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.arch-vile.name'; English: 'Arch-Vile'),
  (Category: 'rank'; RegistryID: 'exp:10'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.cyberdemon.name'; English: 'Cyberdemon'),
  (Category: 'rank'; RegistryID: 'exp:11'; Scope: 'base_game'; Field: 'name'; ID: 'term.rank.exp.apostle.name'; English: 'Apostle'),
  (Category: 'trait'; RegistryID: 'trait_marine'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.trait-marine.name'; English: ''),
  (Category: 'trait'; RegistryID: 'ironman'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.ironman.name'; English: 'Ironman'),
  (Category: 'trait'; RegistryID: 'ironman'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.ironman.quote'; English: '"Just a couple of broken ribs, it''s nothing. To stop me... you''ve got to smash my head or take my heart out."'),
  (Category: 'trait'; RegistryID: 'ironman'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.ironman.desc'; English: 'You''re a diehard piece of shit. You''ll keep on fighting until all your bones are broken and you have no blood left. Every level of this trait increases your health by 20% of your starting HP. Additionally bullet, shrapnel and melee resistance goes up by 10% per level.'),
  (Category: 'trait'; RegistryID: 'finesse'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.finesse.name'; English: 'Finesse'),
  (Category: 'trait'; RegistryID: 'finesse'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.finesse.quote'; English: '"Dance! Dance, bonedaddy!"'),
  (Category: 'trait'; RegistryID: 'finesse'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.finesse.desc'; English: 'Have you heard of an itchy trigger finger? Yours are itchier than the chicken pox, and because of that you can fire rounds and attack 10% faster with every level of this trait.'),
  (Category: 'trait'; RegistryID: 'hellrunner'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.hellrunner.name'; English: 'Hellrunner'),
  (Category: 'trait'; RegistryID: 'hellrunner'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.hellrunner.quote'; English: '"Ohh, here it comes! Here comes the night train! Choo choo cha boogie!"'),
  (Category: 'trait'; RegistryID: 'hellrunner'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.hellrunner.desc'; English: 'You''re like a train on legs - not only do you move 15% faster for every level of this trait but you also get an extra 10% chance to dodge those pesky bullets coming your way.'),
  (Category: 'trait'; RegistryID: 'nails'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.nails.name'; English: 'Tough as nails'),
  (Category: 'trait'; RegistryID: 'nails'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.nails.quote'; English: '"The horrors of Hell could not kill you!"'),
  (Category: 'trait'; RegistryID: 'nails'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.nails.desc'; English: 'That sound you''re hearing isn''t from the bullets flying off the walls, but from the bullets flying off of YOU! Your skin is so hard that per every level of this trait you''ll shrug off 1 more point of damage and receive +10% fire, acid and plasma resistance.'),
  (Category: 'trait'; RegistryID: 'bitch'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.bitch.name'; English: 'Son of a bitch'),
  (Category: 'trait'; RegistryID: 'bitch'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.bitch.quote'; English: '"Kill them all, let God sort them out."'),
  (Category: 'trait'; RegistryID: 'bitch'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.bitch.desc'; English: 'You''re the meanest, toughest bastard in your entire squad. You relish pain and enjoy dishing it out even more. Even demons know you by name, because with every level of this trait, you do 1 more damage than your average Marine.'),
  (Category: 'trait'; RegistryID: 'gun'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.gun.name'; English: 'Son of a gun'),
  (Category: 'trait'; RegistryID: 'gun'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.gun.quote'; English: '"Dig the prowess, the capacity for violence!"'),
  (Category: 'trait'; RegistryID: 'gun'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.gun.desc'; English: 'You love your pistols. You clean them every day and make sure they are always in top condition. You know your pistols so well that for every level of this trait you can fire them 10% faster and deal 3 more damage.'),
  (Category: 'trait'; RegistryID: 'reloader'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.reloader.name'; English: 'Reloader'),
  (Category: 'trait'; RegistryID: 'reloader'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.reloader.quote'; English: '"The humanity! My big gun is out of bullets! I can''t believe it!"'),
  (Category: 'trait'; RegistryID: 'reloader'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.reloader.desc'; English: 'So you''re out of ammo... no problem! You''re especially gifted at keeping your gun well-fed - for every level of this trait, you can reload your gun 30% faster than the average marine!'),
  (Category: 'trait'; RegistryID: 'eagle'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.eagle.name'; English: 'Eagle Eye'),
  (Category: 'trait'; RegistryID: 'eagle'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.eagle.quote'; English: '"One in the heart and one in the head, and don''t you hesitate."'),
  (Category: 'trait'; RegistryID: 'eagle'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.eagle.desc'; English: 'You could knock a fly off the wall at 200 yards, but you prefer to hunt bigger, nastier prey. With each level of this trait, you''ll increase your chance to hit by 2 points.'),
  (Category: 'trait'; RegistryID: 'brute'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.brute.name'; English: 'Brute'),
  (Category: 'trait'; RegistryID: 'brute'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.brute.quote'; English: '"There''s nothing wrong that I can''t fix... with my hands!"'),
  (Category: 'trait'; RegistryID: 'brute'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.brute.desc'; English: 'You don''t need a gun - guns are for wusses! With each level of this trait you''ll deal 3 more damage while bashing your enemies with your hands, knives, body parts, or whatever else is available. Also your melee accuracy increases by 2.'),
  (Category: 'trait'; RegistryID: 'juggler'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.juggler.name'; English: 'Juggler'),
  (Category: 'trait'; RegistryID: 'juggler'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.juggler.quote'; English: '"Allow me to communicate to you my desire to have your guns."'),
  (Category: 'trait'; RegistryID: 'juggler'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.juggler.desc'; English: 'Your hands are so nimble you could work at a circus.  Unfortunately, the army got you first. The only benefit of your skill now is that you instantly swap prepared and inventory weapons, and automatically use a prepared melee weapon when need arises!'),
  (Category: 'trait'; RegistryID: 'berserker'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.berserker.name'; English: 'Berserker'),
  (Category: 'trait'; RegistryID: 'berserker'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.berserker.quote'; English: '"Who''s a man and a half? I''m a man and a half! Berserker packin'' man and a half!"'),
  (Category: 'trait'; RegistryID: 'berserker'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.berserker.desc'; English: 'You hate this place, you hate these stupid monsters, and you HATE that this is all happening to you. In fact you hate it so much that there''s a chance that you''ll fly into a berserk rage when you repeatedly smack someone in melee, or get hit hard enough. (NOTE: You do NOT get the healing effect of a Berserk Pack.)'),
  (Category: 'trait'; RegistryID: 'dualgunner'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.dualgunner.name'; English: 'Dualgunner'),
  (Category: 'trait'; RegistryID: 'dualgunner'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.dualgunner.quote'; English: '"The only thing I believe is I need another gun."'),
  (Category: 'trait'; RegistryID: 'dualgunner'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.dualgunner.desc'; English: 'You''re the kind of guy for whom one is never enough. When you and your buddies cruised bars Earthside, you always had a beer in each hand and when you left, you left with two girls. Where you''re going now there aren''t beer or girls, but there are guns! This trait lets you wield two pistols at once, firing them as fast as one.'),
  (Category: 'trait'; RegistryID: 'dodgemaster'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.dodgemaster.name'; English: 'Dodgemaster'),
  (Category: 'trait'; RegistryID: 'dodgemaster'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.dodgemaster.quote'; English: '"Knock, knock. Who''s there? Me, me, me, me, ME!"'),
  (Category: 'trait'; RegistryID: 'dodgemaster'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.dodgemaster.desc'; English: 'The battlefield is a dance for you! Each first sidestep after your move will automatically succeed.'),
  (Category: 'trait'; RegistryID: 'intuition'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.intuition.name'; English: 'Intuition'),
  (Category: 'trait'; RegistryID: 'intuition'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.intuition.quote'; English: '"As I stride knee deep through the dead, all is clear. I know what must be done."'),
  (Category: 'trait'; RegistryID: 'intuition'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.intuition.desc'; English: 'Something''s kept you alive all these years. Call it a sixth sense, call it a survival instinct, call it blind friggin'' luck. All you know for sure is that where other men die, you live. The first level of this trait lets you evaluate levers and sense powerups, the second level lets you sense monsters.'),
  (Category: 'trait'; RegistryID: 'whizkid'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.whizkid.name'; English: 'Whizkid'),
  (Category: 'trait'; RegistryID: 'whizkid'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.whizkid.quote'; English: '"Not big guns, but they are guns!  And I need guns!"'),
  (Category: 'trait'; RegistryID: 'whizkid'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.whizkid.desc'; English: 'You were always a brainy guy... Mom said you could have been an inventor but the Marine Corps picked you up first. Whether it''s a toaster or a chaingun, there''s always room for improvement! And with each level of this trait you can increase the number of mod slots on a weapon by 2 (by 1 for armor/boot). Also, at level 2+ you can slap (level-1) mods onto an assembly!'),
  (Category: 'trait'; RegistryID: 'badass'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.badass.name'; English: 'Badass'),
  (Category: 'trait'; RegistryID: 'badass'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.badass.quote'; English: '"Who''s the man? I''m the man! How bad? Real bad! I''m a 12.0 on a 10.0 scale of badness!"'),
  (Category: 'trait'; RegistryID: 'badass'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.badass.desc'; English: 'You''re the ultimate badass. Your blood runs so cold that it could make Hell freeze over (if they weren''t too scared to take you). For each level, your maximum health before decay sets in is 50% higher, and you''re knocked back one space less.'),
  (Category: 'trait'; RegistryID: 'shottyman'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.shottyman.name'; English: 'Shottyman'),
  (Category: 'trait'; RegistryID: 'shottyman'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.shottyman.quote'; English: '"At this particular moment in time I don''t believe I have a more deepfelt respect for any object than this shotgun..."'),
  (Category: 'trait'; RegistryID: 'shottyman'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.shottyman.desc'; English: 'You and your shotgun have been through a lot together. You take care of him, and he "takes care" of any dumb bastard to get in your way. Through it all, you''ve learned that, in the middle of a firefight, if you stand still to reload, you die. So by taking this trait you gain the ability to reload shotguns on the move... ALL shotguns, and it surprisingly works for rocket launchers too!'),
  (Category: 'trait'; RegistryID: 'triggerhappy'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.triggerhappy.name'; English: 'Triggerhappy'),
  (Category: 'trait'; RegistryID: 'triggerhappy'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.triggerhappy.quote'; English: '"Ooh, I like it! The sugar-sweet kiss of heavy ordinance!"'),
  (Category: 'trait'; RegistryID: 'triggerhappy'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.triggerhappy.desc'; English: '"Shoot first and shoot fast" has always been your motto. And nobody shoots faster than you. With each rapid-fire weapon you get an extra rapid shot per level of this trait.'),
  (Category: 'trait'; RegistryID: 'blademaster'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.blademaster.name'; English: 'Blademaster'),
  (Category: 'trait'; RegistryID: 'blademaster'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.blademaster.quote'; English: '"Aaah! Chainsaw! The great communicator!"'),
  (Category: 'trait'; RegistryID: 'blademaster'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.blademaster.desc'; English: 'You''ve mastered melee combat. Each time you finish off an opponent, you''re immediately ready for another kill, and gain a free action!'),
  (Category: 'trait'; RegistryID: 'vampyre'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.vampyre.name'; English: 'Vampyre'),
  (Category: 'trait'; RegistryID: 'vampyre'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.vampyre.quote'; English: '"I crave for blood on this kind of night..."'),
  (Category: 'trait'; RegistryID: 'vampyre'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.vampyre.desc'; English: 'You hunger for blood! Each time you finish off an opponent with a melee attack, 10% of the target''s max HP is added to your HP.'),
  (Category: 'trait'; RegistryID: 'malicious'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.malicious.name'; English: 'Malicious Blades'),
  (Category: 'trait'; RegistryID: 'malicious'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.malicious.quote'; English: '"Don''t need a gun! Guns are for wusses!"'),
  (Category: 'trait'; RegistryID: 'malicious'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.malicious.desc'; English: 'Knives, knives, knives! Not only do you do double damage with blades, but you can attack with a blade in each hand at the same time, and while carrying a blade in your off-hand, you parry 75% melee damage, and shield against 50% bullet, shrapnel and fire damage!'),
  (Category: 'trait'; RegistryID: 'bulletdance'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.bulletdance.name'; English: 'Bullet Dance'),
  (Category: 'trait'; RegistryID: 'bulletdance'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.bulletdance.quote'; English: '"Righteousness -- and superior firepower -- has triumphed!"'),
  (Category: 'trait'; RegistryID: 'bulletdance'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.bulletdance.desc'; English: 'Pistols are your game -- you can squeeze an additional shot from each of your pistols for each level of Triggerhappy at half the time cost!'),
  (Category: 'trait'; RegistryID: 'gunkata'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.gunkata.name'; English: 'Gun Kata'),
  (Category: 'trait'; RegistryID: 'gunkata'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.gunkata.quote'; English: '"Not without incident."'),
  (Category: 'trait'; RegistryID: 'gunkata'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.gunkata.desc'; English: 'You''ve mastered the martial art of pistol combat. After each successful dodge you can fire your pistols in 10% of normal time, or, if your last action was a move, in half of the time! Finally, each time you finish off a targeted opponent, you immediately reload your guns!'),
  (Category: 'trait'; RegistryID: 'sharpshooter'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.sharpshooter.name'; English: 'Sharpshooter'),
  (Category: 'trait'; RegistryID: 'sharpshooter'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.sharpshooter.quote'; English: '"My cause is just... my will is strong..."'),
  (Category: 'trait'; RegistryID: 'sharpshooter'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.sharpshooter.desc'; English: 'You always hit them where it counts! Each pistol shot you inflict deals maximum possible damage!'),
  (Category: 'trait'; RegistryID: 'armydead'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.armydead.name'; English: 'Army of the Dead'),
  (Category: 'trait'; RegistryID: 'armydead'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.armydead.quote'; English: '"Might makes light! And I feel mighty!"'),
  (Category: 'trait'; RegistryID: 'armydead'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.armydead.desc'; English: 'You''re the fucking army of justice. When you fire your trusty shotgun, no armor is a protection!'),
  (Category: 'trait'; RegistryID: 'shottyhead'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.shottyhead.name'; English: 'Shottyhead'),
  (Category: 'trait'; RegistryID: 'shottyhead'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.shottyhead.quote'; English: '"Groovy."'),
  (Category: 'trait'; RegistryID: 'shottyhead'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.shottyhead.desc'; English: 'Shotgun is the gun on the move! While you can already reload on the move, this trait allows you to cut firetime to 1/3rd of the original!'),
  (Category: 'trait'; RegistryID: 'fireangel'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.fireangel.name'; English: 'Fireangel'),
  (Category: 'trait'; RegistryID: 'fireangel'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.fireangel.quote'; English: '"Woo baby, I''m burnin'' out of control!"'),
  (Category: 'trait'; RegistryID: 'fireangel'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.fireangel.desc'; English: 'You love heat, you''re the angel of fire! Every missile you fire explodes, and those that already do explode with a +1 radius! Also, no explosion affects you, unless you take a direct hit.'),
  (Category: 'trait'; RegistryID: 'ammochain'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.ammochain.name'; English: 'Ammochain'),
  (Category: 'trait'; RegistryID: 'ammochain'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.ammochain.quote'; English: '"Hey, Chaingun! The hell with respect!"'),
  (Category: 'trait'; RegistryID: 'ammochain'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.ammochain.desc'; English: 'True gunners do not think of such unimportant things like ammo supply! As long as you use your trusty chain-fire weapons you only use up one ammo per volley!'),
  (Category: 'trait'; RegistryID: 'cateye'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.cateye.name'; English: 'Cateye'),
  (Category: 'trait'; RegistryID: 'cateye'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.cateye.quote'; English: '"Huh? Whuzzat? Whuzzat? I like what I see!"'),
  (Category: 'trait'; RegistryID: 'cateye'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.cateye.desc'; English: 'Your eyes are so sharp they could cut through concrete. This trait lets you see your enemies from two spaces further away - and that means more time to shoot them!'),
  (Category: 'trait'; RegistryID: 'entrenchment'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.entrenchment.name'; English: 'Entrenchment'),
  (Category: 'trait'; RegistryID: 'entrenchment'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.entrenchment.quote'; English: '"Hoy, hoy, I''m the boy... Packin'' 80 pounds of heavenly joy!"'),
  (Category: 'trait'; RegistryID: 'entrenchment'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.entrenchment.desc'; English: 'Once the barrels get rollin'' you become one hardcore fighting platform... when chainfiring a rapid weapon you get +50% to all resistances, and volleys after the first, take just one ammo!'),
  (Category: 'trait'; RegistryID: 'survivalist'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.survivalist.name'; English: 'Survivalist'),
  (Category: 'trait'; RegistryID: 'survivalist'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.survivalist.quote'; English: '"You want a piece of me? C''mon, c''mon. Come at me with it!"'),
  (Category: 'trait'; RegistryID: 'survivalist'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.survivalist.desc'; English: 'You''re the mean motherfucker who gets through every predicament! Half the time you completely shrug off damage that would graze others and you heal over 100% using simple medpacks! Additionally small medpacks and globes are twice as effective!'),
  (Category: 'trait'; RegistryID: 'runningman'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.runningman.name'; English: 'Running Man'),
  (Category: 'trait'; RegistryID: 'runningman'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.runningman.quote'; English: '"Movin'' right along."'),
  (Category: 'trait'; RegistryID: 'runningman'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.runningman.desc'; English: 'You''re the man on the run! Not only can you run twice as long, but you do not suffer any aiming penalties while doing so!'),
  (Category: 'trait'; RegistryID: 'gunrunner'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.gunrunner.name'; English: 'Gunrunner'),
  (Category: 'trait'; RegistryID: 'gunrunner'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.gunrunner.quote'; English: '"Movin'' right along."'),
  (Category: 'trait'; RegistryID: 'gunrunner'; Scope: 'base_game'; Field: 'desc'; ID: 'term.trait.gunrunner.desc'; English: 'You''re the man on the run! Not only can you run longer, but while running with a loaded non-rapid weapon in your hands, every move you automatically shoot the nearest enemy for free!'),
  (Category: 'trait'; RegistryID: 'scavenger'; Scope: 'base_game'; Field: 'name'; ID: 'term.trait.scavenger.name'; English: 'Scavenger'),
  (Category: 'trait'; RegistryID: 'scavenger'; Scope: 'base_game'; Field: 'quote'; ID: 'term.trait.scavenger.quote'; English: '"I do need a gun. I need a big gun. I need a really big gun..."'),
