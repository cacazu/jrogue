function DRLHelpTopicIndex(const aID: AnsiString): Integer;
var i: Integer;
begin
  for i := 0 to High(CHelpDocuments) do
    if CHelpDocuments[i].ID = aID then Exit(i);
  Exit(-1);
end;
function DRLHelpSourceLineCount(aTopic: Integer): Integer;
begin
  if (aTopic < 0) or (aTopic > High(CHelpDocuments)) then Exit(0);
  Exit(CHelpDocuments[aTopic].LineCount);
end;
function DRLHelpSourceLine(aTopic, aLine: Integer): AnsiString;
begin
  if (aTopic < 0) or (aTopic > High(CHelpDocuments)) then
    raise EArgumentException.Create('Unknown DRL help topic');
  if (aLine < 0) or (aLine >= CHelpDocuments[aTopic].LineCount) then
    raise EArgumentException.Create('DRL help source line out of bounds');
  Exit(CHelpSourceLines[CHelpDocuments[aTopic].FirstLine + aLine]);
end;
function DRLHelpParagraphCount(aTopic: Integer): Integer;
begin
  if (aTopic < 0) or (aTopic > High(CHelpDocuments)) then Exit(0);
  Exit(CHelpDocuments[aTopic].BlockCount);
end;
function DRLHelpParagraphText(aTopic, aParagraph: Integer): AnsiString;
var iBlock: Integer;
begin
  if (aTopic < 0) or (aTopic > High(CHelpDocuments)) then
    raise EArgumentException.Create('Unknown DRL help topic');
  if (aParagraph < 0) or (aParagraph >= CHelpDocuments[aTopic].BlockCount) then
    raise EArgumentException.Create('DRL help paragraph out of bounds');
  iBlock := CHelpDocuments[aTopic].FirstBlock + aParagraph;
  if CHelpBlocks[iBlock].ID = '' then Exit(CHelpBlocks[iBlock].English);
  Exit(DRLText(CHelpBlocks[iBlock].ID, CHelpBlocks[iBlock].English));
end;
function DRLHelpTopicTitle(aTopic: Integer; const aOriginalTitle: AnsiString): AnsiString;
begin
  if (aTopic < 0) or (aTopic > High(CHelpDocuments)) then Exit(aOriginalTitle);
  if (CHelpDocuments[aTopic].ID = 'intro') and
     (aOriginalTitle = 'Introduction') then
    Exit(DRLText('help.topic.intro', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'start') and
     (aOriginalTitle = 'Getting started') then
    Exit(DRLText('help.topic.start', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'gamepad') and
     (aOriginalTitle = 'Gamepad controls') then
    Exit(DRLText('help.topic.gamepad', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'keys') and
     (aOriginalTitle = 'Keyboard controls') then
    Exit(DRLText('help.topic.keys', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'mouse') and
     (aOriginalTitle = 'Mouse controls') then
    Exit(DRLText('help.topic.mouse', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'feedback') and
     (aOriginalTitle = 'Feedback') then
    Exit(DRLText('help.topic.feedback', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'disclaim') and
     (aOriginalTitle = 'Disclaimer') then
    Exit(DRLText('help.topic.disclaim', aOriginalTitle));
  if (CHelpDocuments[aTopic].ID = 'credits') and
     (aOriginalTitle = 'Credits') then
    Exit(DRLText('help.topic.credits', aOriginalTitle));
  Exit(aOriginalTitle);
end;
end.
